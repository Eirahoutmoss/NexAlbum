<Project>
  <!-- Merkezi paket sürümleri. Yeni paket: yalnızca GPL-3.0 uyumlu lisans; Karar 08 lisans tablosuna ekle. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="Uygulama">
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <!-- Apache 2.0 (Karar 08 §7.2): EXIF/IPTC/XMP ve görüntü boyutu, pikseller çözülmeden. -->
    <PackageVersion Include="MetadataExtractor" Version="2.8.1" />
    <!-- MIT (Karar 08, Karar 11 §3.4): baskı PDF'i; JPEG'ler yeniden sıkıştırılmadan gömülür. -->
    <PackageVersion Include="PDFsharp" Version="6.1.1" />
    <!-- MIT (Karar 08 §5.1, Rev. 5): hikâye filmi kareleri (Karar 21). Linux yerel kitaplığı testler ve Linux için. -->
    <PackageVersion Include="SkiaSharp" Version="3.116.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.116.1" />
  </ItemGroup>
  <ItemGroup Label="Test">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.0.2" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <!-- 7.x'te kalınmalı: 8.0+ Apache 2.0 değil, ticari lisans (Karar 08 Rev. 1). -->
    <PackageVersion Include="FluentAssertions" Version="7.2.0" />
    <!-- BSD-2-Clause (Karar 08, Karar 23): HTML provadaki efekt betiğinin C# hesabıyla eşdeğerlik testi; yalnızca testte. -->
    <PackageVersion Include="Jint" Version="4.1.0" />
  </ItemGroup>
</Project>
