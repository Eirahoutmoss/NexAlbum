<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!-- Fildişi teması: açık krem + altın (Karar 17 §4). Anahtar adları iki temada aynıdır; değerler yalnızca burada yazılır. -->
  <sys:String x:Key="ThemeName">Fildisi</sys:String>
  <sys:Boolean x:Key="ThemeIsDark">False</sys:Boolean>

  <Color x:Key="BackgroundColor">#F4F0E8</Color>
  <Color x:Key="SurfaceColor">#FAF7F1</Color>
  <Color x:Key="SurfaceRaisedColor">#FFFFFF</Color>
  <Color x:Key="SurfaceHoverColor">#EFE8DB</Color>
  <Color x:Key="BorderColor">#E3DACA</Color>
  <Color x:Key="BorderStrongColor">#CFC3AD</Color>
  <Color x:Key="TextColor">#1F1B16</Color>
  <Color x:Key="SecondaryTextColor">#6B6358</Color>
  <Color x:Key="MutedTextColor">#837A6D</Color>
  <Color x:Key="AccentColor">#C99B48</Color>
  <Color x:Key="AccentHoverColor">#D6AC5C</Color>
  <Color x:Key="AccentPressedColor">#AE843A</Color>
  <Color x:Key="OnAccentColor">#1A1408</Color>
  <Color x:Key="AccentTextColor">#8A6522</Color>
  <Color x:Key="SelectionColor">#F1E5CB</Color>
  <Color x:Key="SuccessColor">#2E7D4F</Color>
  <Color x:Key="WarningColor">#9A5806</Color>
  <Color x:Key="ErrorColor">#B83A2E</Color>
  <Color x:Key="InfoColor">#2F6FA8</Color>
  <Color x:Key="TitleBarColor">#EDE7DC</Color>
  <Color x:Key="OverlayColor">#66201A10</Color>
  <Color x:Key="ScrollThumbColor">#CBBFA8</Color>
  <Color x:Key="ScrollThumbHoverColor">#B5A88F</Color>
  <Color x:Key="ShadowColor">#5A4630</Color>
  <sys:Double x:Key="PageShadowOpacity">0.28</sys:Double>

  <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
  <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
  <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
  <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />
  <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />
  <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource SelectionColor}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
  <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
  <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
  <SolidColorBrush x:Key="TitleBarBrush" Color="{StaticResource TitleBarColor}" />
  <SolidColorBrush x:Key="OverlayBrush" Color="{StaticResource OverlayColor}" />
  <SolidColorBrush x:Key="ScrollThumbBrush" Color="{StaticResource ScrollThumbColor}" />
  <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="{StaticResource ScrollThumbHoverColor}" />

  <!-- Tuval: sayfanın çevresi; ortada çok hafif sıcak ışık, kenarlara doğru koyulaşır. -->
  <RadialGradientBrush x:Key="CanvasBackgroundBrush" Center="0.5,0.45" GradientOrigin="0.5,0.45" RadiusX="0.75" RadiusY="0.75">
    <GradientStop Offset="0" Color="#F1ECE2" />
    <GradientStop Offset="1" Color="#E7E0D3" />
  </RadialGradientBrush>
  <!-- Altın: düğme dolgusu ve marka vurgusu için hafif dikey ışık. -->
  <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#D6AC5C" />
    <GradientStop Offset="1" Color="#C99B48" />
  </LinearGradientBrush>
</ResourceDictionary>
