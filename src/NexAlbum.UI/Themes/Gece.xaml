<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!-- Gece teması (varsayılan): koyu antrasit + altın (Karar 17 §4). Anahtar adları iki temada aynıdır; değerler yalnızca burada yazılır. -->
  <sys:String x:Key="ThemeName">Gece</sys:String>
  <sys:Boolean x:Key="ThemeIsDark">True</sys:Boolean>

  <Color x:Key="BackgroundColor">#111113</Color>
  <Color x:Key="SurfaceColor">#18181B</Color>
  <Color x:Key="SurfaceRaisedColor">#222226</Color>
  <Color x:Key="SurfaceHoverColor">#2B2B30</Color>
  <Color x:Key="BorderColor">#2C2C31</Color>
  <Color x:Key="BorderStrongColor">#3E3E45</Color>
  <Color x:Key="TextColor">#ECE8E1</Color>
  <Color x:Key="SecondaryTextColor">#A29C92</Color>
  <Color x:Key="MutedTextColor">#7C776F</Color>
  <Color x:Key="AccentColor">#D4A853</Color>
  <Color x:Key="AccentHoverColor">#E2BC6C</Color>
  <Color x:Key="AccentPressedColor">#B88D3E</Color>
  <Color x:Key="OnAccentColor">#1A1408</Color>
  <Color x:Key="AccentTextColor">#E0B864</Color>
  <Color x:Key="SelectionColor">#2F2819</Color>
  <Color x:Key="SuccessColor">#6CBF7A</Color>
  <Color x:Key="WarningColor">#E8A64A</Color>
  <Color x:Key="ErrorColor">#E5675F</Color>
  <Color x:Key="InfoColor">#7FB2E5</Color>
  <Color x:Key="TitleBarColor">#0E0E10</Color>
  <Color x:Key="OverlayColor">#99000000</Color>
  <Color x:Key="ScrollThumbColor">#45454C</Color>
  <Color x:Key="ScrollThumbHoverColor">#5A5A62</Color>
  <Color x:Key="ShadowColor">#000000</Color>
  <sys:Double x:Key="PageShadowOpacity">0.55</sys:Double>

  <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
  <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
  <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
  <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />
  <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />
  <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource SelectionColor}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
  <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
  <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
  <SolidColorBrush x:Key="TitleBarBrush" Color="{StaticResource TitleBarColor}" />
  <SolidColorBrush x:Key="OverlayBrush" Color="{StaticResource OverlayColor}" />
  <SolidColorBrush x:Key="ScrollThumbBrush" Color="{StaticResource ScrollThumbColor}" />
  <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="{StaticResource ScrollThumbHoverColor}" />

  <!-- Tuval: sayfanın çevresi; ortada çok hafif sıcak ışık, kenarlara doğru koyulaşır. -->
  <RadialGradientBrush x:Key="CanvasBackgroundBrush" Center="0.5,0.45" GradientOrigin="0.5,0.45" RadiusX="0.75" RadiusY="0.75">
    <GradientStop Offset="0" Color="#1C1A17" />
    <GradientStop Offset="1" Color="#0D0D0E" />
  </RadialGradientBrush>
  <!-- Altın: düğme dolgusu ve marka vurgusu için hafif dikey ışık. -->
  <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#E2BC6C" />
    <GradientStop Offset="1" Color="#D4A853" />
  </LinearGradientBrush>
</ResourceDictionary>
