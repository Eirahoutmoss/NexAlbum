<Window x:Class="NexAlbum.UI.Views.BatchEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Toplu düzenleme (rötuş)" Width="860" Height="720" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" UseLayoutRounding="True">
  <DockPanel Margin="24">
    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" Margin="0,0,0,12"
               Text="Kendi Photoshop action'larınızı ya da ücretsiz araçları (darktable, RawTherapee…) fotoğraflara toplu uygulayın. Orijinaller değişmez; her fotoğrafta «Orijinali göster» ile karşılaştırabilir, düzenlemeyi kaldırabilirsiniz." />

    <!-- Alt: ilerleme ve düğmeler -->
    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <ProgressBar Height="6" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}" />
      <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
      <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" Margin="0,4,0,0" />
      <TextBlock Text="{Binding Problem}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
      <ItemsControl ItemsSource="{Binding Failures}" MaxHeight="90">
        <ItemsControl.Template>
          <ControlTemplate>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsPresenter />
            </ScrollViewer>
          </ControlTemplate>
        </ItemsControl.Template>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock FontSize="12" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap">
              <Run Text="{Binding FileName, Mode=OneWay}" FontWeight="SemiBold" />
              <Run Text=": " />
              <Run Text="{Binding Reason, Mode=OneWay}" />
            </TextBlock>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <DockPanel Margin="0,12,0,0">
        <Button DockPanel.Dock="Right" Content="Kapat" IsCancel="True" Padding="18,4" Margin="8,0,0,0" />
        <Button DockPanel.Dock="Right" Content="İptal et" Command="{Binding CancelCommand}" Padding="14,4" Margin="8,0,0,0" />
        <Button DockPanel.Dock="Right" Content="Hepsine uygula" Command="{Binding RunCommand}" Style="{StaticResource AccentButton}" Padding="18,4" Margin="8,0,0,0" />
        <Button DockPanel.Dock="Right" Content="Önce bir fotoğrafta dene" Command="{Binding TryCommand}" Padding="14,4" />
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Kapsam" VerticalAlignment="Center" Margin="0,0,8,0" />
          <ComboBox ItemsSource="{Binding Scopes}" SelectedItem="{Binding SelectedScope}" DisplayMemberPath="Label" Width="230" />
        </StackPanel>
      </DockPanel>
    </StackPanel>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="Araç" FontWeight="SemiBold" />
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <RadioButton Content="Photoshop action'ı" IsChecked="{Binding UsePhotoshop}" GroupName="Engine" Margin="0,0,16,0" />
            <RadioButton Content="Komut satırı aracı" IsChecked="{Binding UseCommandLine}" GroupName="Engine" />
          </StackPanel>

          <StackPanel Margin="0,10,0,0" Visibility="{Binding UsePhotoshop, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Action'ları yükle" Command="{Binding LoadActionsCommand}" Padding="10,2" Margin="6,0,0,0" />
              <ComboBox ItemsSource="{Binding Actions}" SelectedItem="{Binding SelectedAction}" DisplayMemberPath="DisplayName" />
            </DockPanel>
            <TextBlock Text="{Binding PhotoshopStatus}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                       Text="Action içindeki onay pencereleri kapalı çalışır; pencere isteyen adımlar varsayılan değerleriyle uygulanır. Action kaydetme/kapama adımı içermemelidir — NexAlbum kendisi kaydeder." />
          </StackPanel>

          <StackPanel Margin="0,10,0,0" Visibility="{Binding UseCommandLine, Converter={StaticResource BoolToVisibility}}">
            <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Name" />
            <TextBlock Text="Program" Margin="0,8,0,2" />
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Gözat…" Command="{Binding BrowseCommand}" Padding="10,2" Margin="6,0,0,0" />
              <TextBox Text="{Binding Executable, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
            </DockPanel>
            <TextBlock Text="Bağımsız değişkenler (her satıra bir tane)" Margin="0,8,0,2" />
            <TextBox Text="{Binding ArgumentsText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="110"
                     FontFamily="Consolas, Cascadia Mono" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
            <TextBlock Text="{Binding PresetHint}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
          </StackPanel>

          <TextBlock Text="Tarif adı" FontWeight="SemiBold" Margin="0,14,0,2" />
          <TextBox Text="{Binding RecipeName, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                   ToolTip="Dosya adlarında ve fotoğrafın «Düzenlendi» bilgisinde görünür; projeye kaydedilir." />

          <TextBlock Text="Çıktı" FontWeight="SemiBold" Margin="0,14,0,2" />
          <StackPanel Orientation="Horizontal">
            <RadioButton Content="JPEG" IsChecked="{Binding OutputJpeg}" GroupName="Output" Margin="0,0,8,0" VerticalAlignment="Center" />
            <TextBlock Text="kalite" VerticalAlignment="Center" Margin="0,0,4,0" Style="{StaticResource Caption}" />
            <Slider Minimum="1" Maximum="12" Value="{Binding JpegQuality}" IsSnapToTickEnabled="True" TickFrequency="1" Width="110" VerticalAlignment="Center" />
            <TextBlock Text="{Binding JpegQuality}" Width="24" VerticalAlignment="Center" Margin="4,0,16,0" />
            <RadioButton Content="PNG (kayıpsız)" IsChecked="{Binding OutputPng}" GroupName="Output" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                     Text="Renk profili gömülür. TIFF seçilmez: baskı PDF'ine doğrudan gömülemez." />
        </StackPanel>
      </ScrollViewer>

      <!-- Önce / sonra -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Önce" FontWeight="SemiBold" />
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Margin="0,4,0,8">
          <Image Source="{Binding BeforeImage}" Stretch="Uniform" />
        </Border>
        <TextBlock Grid.Row="2" Text="Sonra" FontWeight="SemiBold" />
        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Margin="0,4,0,0">
          <Grid>
            <Image Source="{Binding AfterImage}" Stretch="Uniform" />
            <TextBlock Text="«Önce bir fotoğrafta dene» ile sonucu burada görün." Style="{StaticResource Caption}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="16"
                       Visibility="{Binding HasPreview, Converter={StaticResource InverseBoolToVisibility}}" />
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
