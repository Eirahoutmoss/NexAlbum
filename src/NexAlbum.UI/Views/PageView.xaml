<UserControl x:Class="NexAlbum.UI.Views.PageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:NexAlbum.UI.Controls">
  <!-- Birim: milimetre. Viewbox ekrana ölçekler; koordinatlar taşma payı alanının sol üst köşesine göredir. -->
  <Viewbox Stretch="Uniform">
    <Grid Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" Background="{Binding Background}">
      <ItemsControl ItemsSource="{Binding Slots}" Focusable="False" ItemTemplate="{StaticResource SlotTemplate}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <Canvas />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemContainerStyle>
          <Style TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding X}" />
            <Setter Property="Canvas.Top" Value="{Binding Y}" />
          </Style>
        </ItemsControl.ItemContainerStyle>
      </ItemsControl>

      <!-- Metinler: yuvaların üstünde; satır kırma, harf aralığı ve etkiler PDF ile aynı hesaptan (TextLayout) -->
      <ItemsControl ItemsSource="{Binding Texts}" Focusable="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <Canvas />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemContainerStyle>
          <Style TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding X}" />
            <Setter Property="Canvas.Top" Value="{Binding Y}" />
          </Style>
        </ItemsControl.ItemContainerStyle>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Width="{Binding Width}" Height="{Binding Height}" Background="Transparent" Cursor="SizeAll">
              <ui:AlbumTextView Text="{Binding Text}" />
              <Rectangle x:Name="Outline" Stroke="#D4A853" StrokeThickness="0.5" StrokeDashArray="3 2" Margin="-1" IsHitTestVisible="False"
                         Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Çerçeve kipi: seçili yuvanın biçimi, boyut tutamaçları ve geometrik köşeler -->
      <Canvas DataContext="{Binding FrameEdit}">
        <Polygon Points="{Binding Outline}" Fill="#22D4A853" Stroke="#D4A853" StrokeThickness="{Binding StrokeWidth}" IsHitTestVisible="False" />
        <Rectangle Canvas.Left="{Binding X}" Canvas.Top="{Binding Y}" Width="{Binding Width}" Height="{Binding Height}"
                   Stroke="#D4A853" StrokeThickness="{Binding StrokeWidth}" StrokeDashArray="4 3" IsHitTestVisible="False" />
        <ItemsControl ItemsSource="{Binding Handles}" Focusable="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <Canvas />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemContainerStyle>
            <Style TargetType="ContentPresenter">
              <Setter Property="Canvas.Left" Value="{Binding X}" />
              <Setter Property="Canvas.Top" Value="{Binding Y}" />
            </Style>
          </ItemsControl.ItemContainerStyle>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Rectangle Width="{Binding DataContext.HandleSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                         Height="{Binding DataContext.HandleSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                         Fill="White" Stroke="#B8862F" StrokeThickness="{Binding DataContext.StrokeWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                         Cursor="{Binding Cursor}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl ItemsSource="{Binding Corners}" Focusable="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <Canvas />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemContainerStyle>
            <Style TargetType="ContentPresenter">
              <Setter Property="Canvas.Left" Value="{Binding X}" />
              <Setter Property="Canvas.Top" Value="{Binding Y}" />
            </Style>
          </ItemsControl.ItemContainerStyle>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Ellipse Width="{Binding DataContext.CornerSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                       Height="{Binding DataContext.CornerSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                       Fill="#D4A853" Stroke="White" StrokeThickness="{Binding DataContext.StrokeWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                       Cursor="Cross" ToolTip="Köşeyi sürükleyin" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Canvas>

      <!-- Akıllı hizalama çizgileri (yalnızca sürüklerken) -->
      <ItemsControl ItemsSource="{Binding SnapLines}" Focusable="False" IsHitTestVisible="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <Canvas />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Line x:Name="L" X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}" Stroke="#3B9EFF" StrokeThickness="0.35" />
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding IsCenter}" Value="True">
                <Setter TargetName="L" Property="Stroke" Value="#E0B252" />
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Kapakta sırt katlama çizgileri (yalnızca ekranda) -->
      <ItemsControl ItemsSource="{Binding FoldLines}" Focusable="False" IsHitTestVisible="False"
                    Visibility="{Binding ShowGuides, Converter={StaticResource BoolToVisibility}}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <Canvas />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}" Stroke="#7A5CC8" StrokeThickness="0.4" StrokeDashArray="5 3" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Kesim çizgisi (bitmiş ölçü) ve güvenli alan -->
      <Canvas IsHitTestVisible="False">
        <Rectangle Canvas.Left="{Binding PageArea.X}" Canvas.Top="{Binding PageArea.Y}"
                   Width="{Binding PageArea.Width}" Height="{Binding PageArea.Height}"
                   Stroke="#C62828" StrokeThickness="0.4" StrokeDashArray="4 3"
                   Visibility="{Binding ShowBleedGuide, Converter={StaticResource BoolToVisibility}}" />
        <Rectangle Canvas.Left="{Binding SafeArea.X}" Canvas.Top="{Binding SafeArea.Y}"
                   Width="{Binding SafeArea.Width}" Height="{Binding SafeArea.Height}"
                   Stroke="#0066CC" StrokeThickness="0.3" StrokeDashArray="2 3"
                   Visibility="{Binding ShowSafeGuide, Converter={StaticResource BoolToVisibility}}" />
      </Canvas>
    </Grid>
  </Viewbox>
</UserControl>
