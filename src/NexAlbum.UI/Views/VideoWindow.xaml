<Window x:Class="NexAlbum.UI.Views.VideoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:NexAlbum.UI.Controls"
        Title="{Binding Title}" Width="1320" Height="840" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" UseLayoutRounding="True">
  <!-- Hikâye filmi (Karar 21): ayarlar | önizleme | elle bölüm efektleri -->
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="330" />
      <ColumnDefinition Width="1" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="1" />
      <ColumnDefinition Width="300" />
    </Grid.ColumnDefinitions>

    <!-- Ayarlar -->
    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Background="{DynamicResource SurfaceBrush}">
      <StackPanel Margin="0,8,0,20">
        <TextBlock Text="BİÇİM" Style="{StaticResource PanelHeader}" />
        <ListBox ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}" Margin="12,0" Focusable="False"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Video biçimi">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="3" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="FocusVisualStyle" Value="{x:Null}" />
              <Setter Property="ToolTip" Value="{Binding Name}" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Margin="3" Padding="6,8">
                      <StackPanel>
                        <Grid Height="40">
                          <Viewbox Height="34" Width="34">
                            <Border x:Name="Shape" Width="{Binding Width}" Height="{Binding Height}" CornerRadius="80" BorderThickness="90"
                                    BorderBrush="{DynamicResource SecondaryTextBrush}" />
                          </Viewbox>
                        </Grid>
                        <TextBlock x:Name="T" Text="{Binding Id}" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="{DynamicResource SecondaryTextBrush}" />
                      </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBrush}" />
                        <Setter TargetName="Shape" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        <Setter TargetName="T" Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
        </ListBox>
        <TextBlock Text="{Binding SelectedFormat.Name}" Style="{StaticResource Caption}" Margin="16,4,16,0" />

        <TextBlock Text="STİL" Style="{StaticResource PanelHeader}" />
        <ListBox ItemsSource="{Binding Styles}" SelectedItem="{Binding SelectedStyle}" Margin="12,0" Focusable="False"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Stil">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="FocusVisualStyle" Value="{x:Null}" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Margin="3" Padding="12,8">
                      <StackPanel>
                        <TextBlock x:Name="T" Text="{Binding DisplayName}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Hint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                      </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBrush}" />
                        <Setter TargetName="T" Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
        </ListBox>

        <TextBlock Text="SÜRE VE AKICILIK" Style="{StaticResource PanelHeader}" />
        <DockPanel Margin="16,0,16,6">
          <TextBlock Text="Süre" Width="86" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding DurationOptions}" SelectedItem="{Binding SelectedDuration}" DisplayMemberPath="Name" AutomationProperties.Name="Süre" />
        </DockPanel>
        <DockPanel Margin="16,0,16,6">
          <TextBlock Text="Kare hızı" Width="86" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding FpsOptions}" SelectedItem="{Binding SelectedFps}" ItemStringFormat="{}{0} kare/sn" AutomationProperties.Name="Kare hızı" />
        </DockPanel>
        <CheckBox Margin="16,4,16,4" IsChecked="{Binding ChapterTitles}" Content="Açılış ve bölüm başlıkları" />
        <CheckBox Margin="16,0,16,0" IsChecked="{Binding ReduceMotion}" Content="Hareketi azalt (yalnızca yumuşak geçişler)" />

        <TextBlock Text="MÜZİK" Style="{StaticResource PanelHeader}" />
        <DockPanel Margin="16,0,16,6">
          <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" ui:Ui.Icon="{StaticResource Icon.AddFolder}" Command="{Binding AddMusicFolderCommand}"
                  ToolTip="Müzik klasörü ekle" AutomationProperties.Name="Müzik klasörü ekle" Margin="6,0,0,0" />
          <ComboBox ItemsSource="{Binding MusicTracks}" SelectedItem="{Binding SelectedTrack}" DisplayMemberPath="Title" AutomationProperties.Name="Müzik" />
        </DockPanel>
        <StackPanel Orientation="Horizontal" Margin="16,0,16,0">
          <ui:NexIcon Data="{StaticResource Icon.Music}" Width="13" Height="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,6,0" />
          <TextBlock Text="{Binding MusicStatus}" Style="{StaticResource Caption}" TextWrapping="Wrap" MaxWidth="270" />
        </StackPanel>
        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="16,6,16,0"
                   Text="Müzik bilgisayarınızdaki klasörlerden gelir; NexAlbum müzik dağıtmaz. Sosyal medyada telifli müzik paylaşımı kısıtlanabilir." />

        <TextBlock Text="FFMPEG" Style="{StaticResource PanelHeader}" />
        <TextBlock Text="{Binding FfmpegStatus}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="16,0,16,6" />
        <WrapPanel Margin="16,0,12,0">
          <Button Style="{StaticResource SmallButton}" Content="Şimdi kur" Command="{Binding InstallFfmpegCommand}" Margin="0,0,6,6"
                  ToolTip="İzninizle indirip kurar (yaklaşık 100 MB)" />
          <Button Style="{StaticResource SmallButton}" Content="Yerini göster" Command="{Binding LocateFfmpegCommand}" Margin="0,0,6,6" />
        </WrapPanel>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Column="1" Background="{DynamicResource BorderBrush}" />

    <!-- Önizleme -->
    <DockPanel Grid.Column="2" Background="{DynamicResource CanvasBackgroundBrush}">
      <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}" Padding="20,12">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource SmallButton}" Content="Klasörde göster" Command="{Binding RevealCommand}" Margin="0,0,8,0" />
            <Button Style="{StaticResource SmallButton}" Content="İptal" Command="{Binding CancelExportCommand}" Margin="0,0,8,0"
                    Visibility="{Binding IsExporting, Converter={StaticResource BoolToVisibility}}" />
            <Button Style="{StaticResource AccentButton}" Command="{Binding ExportCommand}" Padding="16,7">
              <StackPanel Orientation="Horizontal">
                <ui:NexIcon Data="{StaticResource Icon.Download}" Width="16" Height="16" Margin="0,0,8,0" />
                <TextBlock Text="MP4 olarak dışa aktar" />
              </StackPanel>
            </Button>
          </StackPanel>
          <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
            <TextBlock Text="{Binding ExportStatus}" Style="{StaticResource Caption}" />
            <ProgressBar Value="{Binding ExportProgress, Mode=OneWay}" Maximum="1" Height="4" Margin="0,6,0,0"
                         Visibility="{Binding IsExporting, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Border DockPanel.Dock="Bottom" Padding="20,8,20,12">
        <StackPanel>
          <DockPanel>
            <Button DockPanel.Dock="Left" Command="{Binding PlayCommand}" Width="38" Height="38" Margin="0,0,10,0"
                    ToolTip="Oynat / durdur (müzikle)" AutomationProperties.Name="Oynat">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                  <Setter Property="ui:Ui.Icon" Value="{StaticResource Icon.Play}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                      <Setter Property="ui:Ui.Icon" Value="{StaticResource Icon.Pause}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" VerticalAlignment="Center" Margin="10,0,0,0" FontFamily="Consolas, Cascadia Mono" />
            <Slider Minimum="0" Maximum="{Binding Duration}" Value="{Binding PreviewSeconds}" VerticalAlignment="Center" AutomationProperties.Name="Zaman" />
          </DockPanel>
          <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" Margin="48,6,0,0" />
          <TextBlock Text="{Binding Notes}" Style="{StaticResource Caption}" Margin="48,2,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Margin="28" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Black">
        <Border.Effect>
          <DropShadowEffect BlurRadius="26" ShadowDepth="4" Opacity="0.55" />
        </Border.Effect>
        <Image Source="{Binding Preview}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Önizleme" />
      </Border>
    </DockPanel>
    <Border Grid.Column="3" Background="{DynamicResource BorderBrush}" />

    <!-- Elle bölüm efektleri -->
    <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto" Background="{DynamicResource SurfaceBrush}">
      <StackPanel Margin="0,8,0,20">
        <TextBlock Text="BÖLÜM EFEKTLERİ" Style="{StaticResource PanelHeader}" />
        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="16,-2,16,8"
                   Text="«Otomatik» stilden gelir. Bir bölüm için geçişi ya da görünümü seçerseniz yalnızca o bölüm değişir." />
        <Border Style="{StaticResource Card}" Margin="16,0" Padding="12,10" Visibility="{Binding HasChapters, Converter={StaticResource InverseBoolToVisibility}}">
          <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                     Text="Bölüm yok: film tek akış olarak kurulur. Hikâye sekmesinde «Bölümleri bul» ile evreleri ayırabilirsiniz." />
        </Border>
        <ItemsControl ItemsSource="{Binding Chapters}" Margin="12,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Margin="0,0,0,8" Padding="12,10">
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,0,8" />
                  <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="Geçiş" Width="66" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <ComboBox ItemsSource="{Binding Transitions}" SelectedItem="{Binding Transition}" DisplayMemberPath="Name" AutomationProperties.Name="Geçiş" />
                  </DockPanel>
                  <DockPanel>
                    <TextBlock Text="Görünüm" Width="66" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <ComboBox ItemsSource="{Binding Looks}" SelectedItem="{Binding Look}" DisplayMemberPath="Name" AutomationProperties.Name="Görünüm" />
                  </DockPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
