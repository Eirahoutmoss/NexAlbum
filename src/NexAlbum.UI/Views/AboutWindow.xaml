<Window x:Class="NexAlbum.UI.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:NexAlbum.UI.Controls"
        Title="NexAlbum hakkında" Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" UseLayoutRounding="True">
  <StackPanel>
    <!-- Marka bandı -->
    <Grid Background="{DynamicResource CanvasBackgroundBrush}">
      <Viewbox Stretch="Fill" VerticalAlignment="Bottom" Height="60" IsHitTestVisible="False" Opacity="0.6">
        <Canvas Width="540" Height="60">
          <Path StrokeThickness="1" Data="M -10 40 C 120 10, 220 70, 330 34 S 480 10, 560 30">
            <Path.Stroke>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0" Color="#00C99A44" />
                <GradientStop Offset="0.5" Color="#AAE2B964" />
                <GradientStop Offset="1" Color="#00C99A44" />
              </LinearGradientBrush>
            </Path.Stroke>
          </Path>
        </Canvas>
      </Viewbox>
      <StackPanel Orientation="Horizontal" Margin="28,28,28,30">
        <Image Source="{StaticResource LogoImage}" Width="72" Height="72" />
        <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
          <ContentControl Style="{StaticResource Wordmark}" FontSize="30" />
          <TextBlock Text="Fotoğraflarınızı Hikayeye Dönüştürün" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0" />
          <TextBlock x:Name="VersionText" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,6,0,0" />
        </StackPanel>
      </StackPanel>
    </Grid>
    <Border Height="1" Background="{DynamicResource BorderBrush}" />

    <StackPanel Margin="28,20,28,24">
      <TextBlock TextWrapping="Wrap" LineHeight="20"
                 Text="Fotoğrafçılar için ücretsiz ve açık kaynak albüm tasarım stüdyosu. Yüzlerce fotoğrafı dakikalar içinde doğru ölçüde, baskıya hazır bir albüme dönüştürür." />
      <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="18" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}"
                 Text="Hesap, bulut, abonelik ve reklam yoktur. Verileriniz bilgisayarınızda kalır. Ölçü, taşma payı ve renk değerleri asla uydurulmaz." />

      <Border Margin="0,18,0,0" Style="{StaticResource Card}" Padding="14,12">
        <DockPanel>
          <Grid DockPanel.Dock="Left" Width="36" Height="36" VerticalAlignment="Top">
            <Ellipse Fill="{DynamicResource SelectionBrush}" />
            <TextBlock Text="HG" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource AccentTextBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
          <StackPanel Margin="12,0,0,0">
            <TextBlock Text="GELİŞTİRİCİ" Style="{StaticResource PanelHeader}" Margin="0" />
            <TextBlock x:Name="AuthorText" FontWeight="SemiBold" FontSize="14" Margin="0,3,0,0" />
            <TextBlock Margin="0,2,0,0">
              <Hyperlink x:Name="AuthorLink" RequestNavigate="OnNavigate">
                <Run x:Name="AuthorLinkText" />
              </Hyperlink>
            </TextBlock>
            <TextBlock Margin="0,6,0,0" Style="{StaticResource Caption}" Text="NexAlbum, Nex uygulama ailesinin bir parçasıdır." />
          </StackPanel>
        </DockPanel>
      </Border>

      <TextBlock Margin="0,18,0,0" Text="LİSANS" Style="{StaticResource PanelHeader}" />
      <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12.5" LineHeight="18">
        <Run Text="GNU Genel Kamu Lisansı v3 veya sonrası (GPL-3.0-or-later). Kaynak kodu:" />
        <Hyperlink x:Name="RepoLink" RequestNavigate="OnNavigate">
          <Run x:Name="RepoLinkText" />
        </Hyperlink>
      </TextBlock>

      <TextBlock Margin="0,16,0,0" Text="ÜÇÜNCÜ TARAF BİLEŞENLER" Style="{StaticResource PanelHeader}" />
      <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12" LineHeight="18" Foreground="{DynamicResource SecondaryTextBrush}"
                 Text=".NET (MIT) · CommunityToolkit.Mvvm (MIT) · MetadataExtractor (Apache 2.0) · PDFsharp (MIT) · Inter yazı tipi (SIL OFL 1.1) · Lucide ikonları (ISC)" />

      <Button Content="Kapat" IsCancel="True" IsDefault="True" HorizontalAlignment="Right" Padding="20,6" Margin="0,22,0,0"
              Style="{StaticResource AccentButton}" />
    </StackPanel>
  </StackPanel>
</Window>
