<Window x:Class="NexAlbum.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:NexAlbum.UI.Views"
        xmlns:ui="clr-namespace:NexAlbum.UI.Controls"
        xmlns:vm="clr-namespace:NexAlbum.UI.ViewModels"
        Title="{Binding Title}"
        Width="1440" Height="900" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Icon="/NexAlbum;component/Assets/NexAlbum.ico"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True">
  <!-- Marka başlığı (Karar 17 §8): Windows başlık çubuğu yerine; sürükleme, çift tık, kenardan boyutlandırma korunur. -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <!-- Karar 12 §10 kısayolları; Ctrl+K komut paleti (§11), Ctrl+± / Ctrl+0 / Ctrl+F yakınlaştırma (§10.3) -->
  <Window.InputBindings>
    <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}" />
    <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}" />
    <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
    <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsCommand}" />
    <KeyBinding Key="G" Modifiers="Control" Command="{Binding AutoLayoutCommand}" />
    <KeyBinding Key="L" Modifiers="Control" Command="{Binding ToggleLockCommand}" />
    <KeyBinding Key="E" Modifiers="Control" Command="{Binding ExportPdfCommand}" />
    <KeyBinding Key="K" Modifiers="Control" Command="{Binding OpenPaletteCommand}" />
    <KeyBinding Key="P" Modifiers="Control+Shift" Command="{Binding OpenPaletteCommand}" />
    <KeyBinding Key="OemPlus" Modifiers="Control" Command="{Binding Zoom.ZoomInCommand}" />
    <KeyBinding Key="Add" Modifiers="Control" Command="{Binding Zoom.ZoomInCommand}" />
    <KeyBinding Key="OemMinus" Modifiers="Control" Command="{Binding Zoom.ZoomOutCommand}" />
    <KeyBinding Key="Subtract" Modifiers="Control" Command="{Binding Zoom.ZoomOutCommand}" />
    <KeyBinding Key="D0" Modifiers="Control" Command="{Binding Zoom.ActualSizeCommand}" />
    <KeyBinding Key="NumPad0" Modifiers="Control" Command="{Binding Zoom.ActualSizeCommand}" />
    <KeyBinding Key="F" Modifiers="Control" Command="{Binding Zoom.FitCommand}" />
    <KeyBinding Key="PageUp" Command="{Binding PreviousPageCommand}" />
    <KeyBinding Key="PageDown" Command="{Binding NextPageCommand}" />
    <KeyBinding Key="F1" Command="{Binding AboutCommand}" />
    <KeyBinding Key="B" Modifiers="Control" Command="{Binding ToggleBookViewCommand}" />
    <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
    <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
    <KeyBinding Key="Z" Modifiers="Control+Shift" Command="{Binding RedoCommand}" />
    <KeyBinding Key="D" Modifiers="Control" Command="{Binding DuplicatePageCommand}" />
    <KeyBinding Key="F5" Command="{Binding PresentCommand}" />
    <KeyBinding Key="Delete" Command="{Binding DeleteTextCommand}" />
    <KeyBinding Key="T" Modifiers="Control" Command="{Binding AddTextCommand}" CommandParameter="{x:Static vm:MainViewModel.DefaultTextPreset}" />
  </Window.InputBindings>

  <Window.Resources>
    <DataTemplate x:Key="CanvasPage">
      <views:PageView />
    </DataTemplate>
    <Style x:Key="ToolbarDivider" TargetType="Rectangle">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Margin" Value="8,0" />
      <Setter Property="Fill" Value="{DynamicResource BorderBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="SectionText" TargetType="TextBlock">
      <Setter Property="Margin" Value="16,0" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="LineHeight" Value="19" />
    </Style>
    <!-- Sağ panel ve galeri başlık satırı: büyük harf başlık + sağda küçük eylem -->
    <Style x:Key="HeaderRow" TargetType="DockPanel">
      <Setter Property="Margin" Value="16,18,12,8" />
      <Setter Property="LastChildFill" Value="True" />
    </Style>
    <Style x:Key="HeaderText" TargetType="TextBlock" BasedOn="{StaticResource PanelHeader}">
      <Setter Property="Margin" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Resources>

  <Border x:Name="RootBorder">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="40" />
        <RowDefinition Height="62" />
        <RowDefinition Height="*" />
        <RowDefinition Height="1" />
        <RowDefinition Height="154" MinHeight="120" MaxHeight="260" />
        <RowDefinition Height="28" />
      </Grid.RowDefinitions>

      <!-- ① Başlık çubuğu -->
      <Border Grid.Row="0" Background="{DynamicResource TitleBarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
            <Image Source="{StaticResource LogoSmallImage}" Width="24" Height="24" />
            <ContentControl Style="{StaticResource Wordmark}" FontSize="15" Margin="9,0,0,1" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center"
                        Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}">
              <Rectangle Width="1" Height="16" Fill="{DynamicResource BorderStrongBrush}" Margin="0,0,14,0" />
              <TextBlock Text="{Binding ProjectDisplayName}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12.5"
                         TextTrimming="CharacterEllipsis" MaxWidth="260" VerticalAlignment="Center" />
              <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" Margin="8,1,0,0" VerticalAlignment="Center" ToolTip="Kaydedilmemiş değişiklik var"
                       Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" />
              <!-- Geri al / yinele (Ctrl+Z / Ctrl+Y) -->
              <StackPanel Orientation="Horizontal" Margin="14,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource IconButton}" ui:Ui.Icon="{StaticResource Icon.Undo}" Width="28" Height="28"
                        Command="{Binding UndoCommand}" ToolTip="{Binding UndoToolTip}" />
                <Button Style="{StaticResource IconButton}" ui:Ui.Icon="{StaticResource Icon.Redo}" Width="28" Height="28"
                        Command="{Binding RedoCommand}" ToolTip="{Binding RedoToolTip}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>

          <!-- Komut paleti girişi -->
          <Button Grid.Column="1" Width="340" Height="28" Command="{Binding OpenPaletteCommand}" WindowChrome.IsHitTestVisibleInChrome="True"
                  ToolTip="Tüm komutlar (Ctrl+K)" Padding="10,0" HorizontalContentAlignment="Stretch"
                  Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" FontWeight="Normal">
            <DockPanel>
              <Border DockPanel.Dock="Right" Style="{StaticResource KeyBadge}">
                <TextBlock Text="Ctrl+K" />
              </Border>
              <ui:NexIcon Data="{StaticResource Icon.Search}" Width="14" Height="14" Foreground="{DynamicResource MutedTextBrush}" />
              <TextBlock Text="Komut ara…" Margin="8,0,0,0" Foreground="{DynamicResource MutedTextBrush}" FontSize="12.5" VerticalAlignment="Center" />
            </DockPanel>
          </Button>

          <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Command="{Binding ToggleThemeCommand}" ToolTip="{Binding ThemeToggleToolTip}" Margin="0,0,2,0">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                  <Setter Property="ui:Ui.Icon" Value="{StaticResource Icon.Moon}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                      <Setter Property="ui:Ui.Icon" Value="{StaticResource Icon.Sun}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <Button Style="{StaticResource IconButton}" ui:Ui.Icon="{StaticResource Icon.Settings}" Command="{Binding EditSettingsCommand}"
                    ToolTip="Ayarlar: tema, harici düzenleyici, düzenlenmiş dosyaların klasörü" Margin="0,0,2,0" />
            <Button Style="{StaticResource IconButton}" ui:Ui.Icon="{StaticResource Icon.Info}" Command="{Binding AboutCommand}"
                    ToolTip="Hakkında (F1)" Margin="0,0,10,0" />
            <Button Style="{StaticResource CaptionButton}" ui:Ui.Icon="{StaticResource Icon.Minimize}" Click="OnMinimize" ToolTip="Simge durumuna küçült" />
            <Button x:Name="MaxButton" Click="OnMaximizeRestore">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource CaptionButton}">
                  <Setter Property="ui:Ui.Icon" Value="{StaticResource Icon.Maximize}" />
                  <Setter Property="ToolTip" Value="Ekranı kapla" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                      <Setter Property="ui:Ui.Icon" Value="{StaticResource Icon.Restore}" />
                      <Setter Property="ToolTip" Value="Önceki boyut" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <Button Style="{StaticResource CloseCaptionButton}" ui:Ui.Icon="{StaticResource Icon.Close}" Click="OnCloseWindow" ToolTip="Kapat" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- ② Araç çubuğu -->
      <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
        <DockPanel Margin="10,0" LastChildFill="False">
          <Button DockPanel.Dock="Right" Style="{StaticResource OutlineAccentButton}" Command="{Binding ExportPdfCommand}" VerticalAlignment="Center"
                  Height="36" Padding="14,0" ToolTip="Baskı PDF'i: taşma payı, kesim işaretleri, TrimBox/BleedBox (Ctrl+E)">
            <StackPanel Orientation="Horizontal">
              <ui:NexIcon Data="{StaticResource Icon.Export}" Width="17" Height="17" />
              <TextBlock Text="PDF Çıktı" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource CommandButton}" ui:Ui.Icon="{StaticResource Icon.New}" Content="Yeni" Command="{Binding NewCommand}" ToolTip="Yeni proje (Ctrl+N)" />
            <Button Style="{StaticResource CommandButton}" ui:Ui.Icon="{StaticResource Icon.Open}" Content="Aç" Command="{Binding OpenCommand}" ToolTip="Proje aç (Ctrl+O)" />
            <Button Style="{StaticResource CommandButton}" ui:Ui.Icon="{StaticResource Icon.Save}" Content="Kaydet" Command="{Binding SaveCommand}" ToolTip="Kaydet (Ctrl+S) · Farklı kaydet: Ctrl+Shift+S" />
            <Rectangle Style="{StaticResource ToolbarDivider}" />
            <Button Style="{StaticResource CommandButton}" ui:Ui.Icon="{StaticResource Icon.AddPhotos}" Content="Fotoğraf" Command="{Binding ImportFilesCommand}"
                    ToolTip="Fotoğraf dosyalarını seç (Ctrl/Shift ile birden çok). Gezgin'den galeriye sürükleyip bırakmak da olur." />
            <Button Style="{StaticResource CommandButton}" ui:Ui.Icon="{StaticResource Icon.AddFolder}" Content="Klasör" Command="{Binding ImportCommand}"
                    ToolTip="Bir klasördeki tüm fotoğrafları ekle (alt klasörler dahil)" />
            <Rectangle Style="{StaticResource ToolbarDivider}" />

            <!-- Otomatik oluşturma: mod + birincil eylem + farklı sonuç -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
              <ComboBox ItemsSource="{Binding LayoutModes}" SelectedItem="{Binding SelectedMode}" DisplayMemberPath="Name"
                        Width="112" Height="36" VerticalAlignment="Center" ToolTip="Üretim modu: Hızlı · Dengeli · Kontrollü (Karar 10 §13)" />
              <Button Style="{StaticResource AccentButton}" Command="{Binding AutoLayoutCommand}" Height="36" Margin="6,0,0,0" Padding="16,0"
                      ToolTip="Fotoğraflardan albümü otomatik oluştur (Ctrl+G). Kilitli sayfalar korunur.">
                <StackPanel Orientation="Horizontal">
                  <ui:NexIcon Data="{StaticResource Icon.AutoLayout}" Width="17" Height="17" StrokeThickness="1.8" />
                  <TextBlock Text="Oto Oluştur" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
            <Button Style="{StaticResource CommandButton}" ui:Ui.Icon="{StaticResource Icon.Shuffle}" Content="Farklı" Command="{Binding ShuffleCommand}"
                    ToolTip="Aynı fotoğraflarla farklı bir düzen dene" />
            <Rectangle Style="{StaticResource ToolbarDivider}" />
            <Button Style="{StaticResource CommandButton}" ui:Ui.Icon="{StaticResource Icon.Retouch}" Content="Rötuş" Command="{Binding BatchEditCommand}"
                    ToolTip="Photoshop action'ı ya da darktable/RawTherapee ile toplu rötuş (orijinaller değişmez)" />
            <Button Style="{StaticResource CommandButton}" ui:Ui.Icon="{StaticResource Icon.Profile}" Content="Profil" Command="{Binding EditProfileCommand}"
                    ToolTip="Baskı profilini düzenle (taşma payı, güvenli alan, DPI…)" />
            <Button Style="{StaticResource CommandButton}" ui:Ui.Icon="{StaticResource Icon.Preflight}" Content="Ön kontrol" Command="{Binding PreflightCommand}"
                    ToolTip="Baskı öncesi kontrol: DPI, eksik dosya, boş yuva, güvenli alan" />
            <Rectangle Style="{StaticResource ToolbarDivider}" />
            <Button ui:Ui.Icon="{StaticResource Icon.Book}" Content="Kitap" Command="{Binding ToggleBookViewCommand}"
                    ToolTip="Kitap görünümü: karşılıklı iki sayfa, ortada cilt (Ctrl+B)">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource CommandButton}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsBookView}" Value="True">
                      <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
                      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <Button Style="{StaticResource CommandButton}" ui:Ui.Icon="{StaticResource Icon.Present}" Content="Sunum" Command="{Binding PresentCommand}"
                    ToolTip="Sunum modu: tam ekran, yalnızca sayfalar — çiftle birlikte bakmak için (F5)" />
            <Button Style="{StaticResource CommandButton}" ui:Ui.Icon="{StaticResource Icon.Film}" Content="Film" Command="{Binding FilmCommand}"
                    ToolTip="Hikâye filmi: geçiş efektli, müzikli video — sosyal medya (9:16, 1:1, 4:5) ya da 2K/4K film" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Orta bölge: ③ galeri | ④ tuval | ⑤ özellikler -->
      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="300" MinWidth="220" MaxWidth="520" />
          <ColumnDefinition Width="1" />
          <ColumnDefinition Width="*" MinWidth="420" />
          <ColumnDefinition Width="1" />
          <ColumnDefinition Width="348" MinWidth="280" MaxWidth="560" />
        </Grid.ColumnDefinitions>

        <!-- ③ Galeri -->
        <DockPanel Grid.Column="0" Background="{DynamicResource SurfaceBrush}">
          <DockPanel DockPanel.Dock="Top" Style="{StaticResource HeaderRow}">
            <TextBlock DockPanel.Dock="Right" Text="{Binding PhotoSummary}" Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="NoWrap" />
            <TextBlock Text="GALERİ" Style="{StaticResource HeaderText}" />
          </DockPanel>
          <WrapPanel DockPanel.Dock="Top" Margin="14,0,8,6">
            <RadioButton Style="{StaticResource ChipRadio}" GroupName="GalleryFilter" Content="{Binding FilterAllText}" IsChecked="{Binding IsFilterAll}" />
            <RadioButton Style="{StaticResource ChipRadio}" GroupName="GalleryFilter" Content="{Binding FilterUnusedText}" IsChecked="{Binding IsFilterUnused}"
                         ToolTip="Henüz albüme yerleşmemiş fotoğraflar" />
            <RadioButton Style="{StaticResource ChipRadio}" GroupName="GalleryFilter" Content="{Binding FilterUsedText}" IsChecked="{Binding IsFilterUsed}" />
            <RadioButton Style="{StaticResource ChipRadio}" GroupName="GalleryFilter" Content="{Binding FilterEditedText}" IsChecked="{Binding IsFilterEdited}"
                         ToolTip="Düzenleyicide ya da toplu rötuşla düzenlenmiş fotoğraflar" />
            <RadioButton Style="{StaticResource ChipRadio}" GroupName="GalleryFilter" IsChecked="{Binding IsFilterFavorites}" AutomationProperties.Name="Favoriler"
                         ToolTip="Favoriler (F): otomatik yerleşimde önce ve oranına en uygun yuvaya yerleşir">
              <StackPanel Orientation="Horizontal">
                <ui:NexIcon Data="{StaticResource Icon.Star}" Width="12" Height="12" Fill="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentBrush}"
                            Margin="0,0,5,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding FilterFavoritesText}" VerticalAlignment="Center" />
              </StackPanel>
            </RadioButton>
          </WrapPanel>
          <DockPanel DockPanel.Dock="Top" Margin="16,0,16,8">
            <ComboBox DockPanel.Dock="Right" Width="150" ItemsSource="{Binding GallerySortOptions}" SelectedItem="{Binding SelectedGallerySort}"
                      DisplayMemberPath="Name" AutomationProperties.Name="Galeri sıralaması" />
            <TextBlock Text="Sırala" Style="{StaticResource Caption}" VerticalAlignment="Center" />
          </DockPanel>
          <Grid>
            <ListBox x:Name="Gallery" ItemsSource="{Binding GalleryRows}" Padding="10,0,6,10"
                     AllowDrop="True" DragOver="OnFileDragOver" Drop="OnGalleryDrop"
                     PreviewMouseLeftButtonDown="OnGalleryMouseDown" PreviewMouseMove="OnGalleryMouseMove" PreviewMouseLeftButtonUp="OnGalleryMouseUp"
                     PreviewMouseRightButtonDown="OnGalleryRightButtonDown" MouseDoubleClick="OnGalleryDoubleClick" SizeChanged="OnGallerySizeChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
              <!-- Dikey çubuk hep yer ayırır: kare yüksekliği genişliğe bağlı olduğundan "Auto" çubuk görün/kaybol döngüsüne (sonsuz düzen) girer. -->
              <ListBox.InputBindings>
                <!-- Yalnızca galeri odaktayken: yazı kutularındaki "f" harfini yutmaz. -->
                <KeyBinding Key="F" Command="{Binding ToggleFavoriteCommand}" />
              </ListBox.InputBindings>
              <ListBox.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Favori yap / kaldır" Command="{Binding ToggleFavoriteCommand}" InputGestureText="F" />
                  <MenuItem Header="Buradan yeni bölüm" Command="{Binding SplitStoryHereCommand}" />
                  <Separator />
                  <MenuItem Header="Düzenleyicide aç" Command="{Binding OpenInEditorCommand}" />
                  <MenuItem Header="Toplu rötuş…" Command="{Binding BatchEditCommand}" />
                  <Separator />
                  <MenuItem Header="Düzenlemeyi kaldır" Command="{Binding RemoveEditCommand}" />
                </ContextMenu>
              </ListBox.ContextMenu>
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Focusable" Value="False" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Rows="1" Columns="{Binding DataContext.GalleryColumns, RelativeSource={RelativeSource AncestorType=Window}}" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <!-- Fotoğraf karesi: yuvarlatılmış küçük resim + durum rozetleri -->
                        <Grid x:Name="Tile" Margin="3" Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}" Cursor="Hand"
                              Background="Transparent" ToolTip="{Binding ToolTipText}">
                          <Border CornerRadius="7" Background="{DynamicResource SurfaceHoverBrush}" />
                          <Border CornerRadius="7">
                            <Border.Background>
                              <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                            </Border.Background>
                          </Border>
                          <Border x:Name="Missing" CornerRadius="7" Background="#B3000000" Visibility="{Binding IsMissing, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                              <ui:NexIcon Data="{StaticResource Icon.Error}" Width="18" Height="18" Foreground="{DynamicResource ErrorBrush}" />
                              <TextBlock Text="Dosya yok" FontSize="10.5" Foreground="White" Margin="0,4,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                          </Border>
                          <!-- Albümde: altın onay -->
                          <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource AccentBrush}" Margin="5"
                                  HorizontalAlignment="Right" VerticalAlignment="Bottom" ToolTip="Albümde"
                                  Visibility="{Binding IsUsed, Converter={StaticResource BoolToVisibility}}">
                            <ui:NexIcon Data="{StaticResource Icon.Check}" Width="12" Height="12" StrokeThickness="3" Foreground="{DynamicResource OnAccentBrush}" />
                          </Border>
                          <!-- Rötuşlu -->
                          <Border Width="20" Height="20" CornerRadius="10" Background="#CC111113" Margin="5"
                                  HorizontalAlignment="Left" VerticalAlignment="Top" ToolTip="{Binding EditBadge}"
                                  Visibility="{Binding IsEdited, Converter={StaticResource BoolToVisibility}}">
                            <ui:NexIcon Data="{StaticResource Icon.Retouch}" Width="12" Height="12" StrokeThickness="2" Foreground="#E0B864" />
                          </Border>
                          <!-- Hikâye bölümünün rengi -->
                          <Border Height="3" CornerRadius="1.5" Margin="8,0,30,4" VerticalAlignment="Bottom" Background="{Binding ChapterColor}" IsHitTestVisible="False" />
                          <!-- Favori: yıldız (favoriyse hep, değilse üzerine gelince) -->
                          <Button x:Name="Star" Style="{StaticResource StarButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                                  Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                  Tag="{Binding IsFavorite}" Visibility="Hidden" ToolTip="Favori (F)" AutomationProperties.Name="Favori" />
                          <Border x:Name="Ring" CornerRadius="8" BorderThickness="2" Margin="-2" BorderBrush="Transparent" IsHitTestVisible="False" />
                        </Grid>
                        <DataTemplate.Triggers>
                          <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                            <Setter TargetName="Star" Property="Visibility" Value="Visible" />
                          </Trigger>
                          <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                            <Setter TargetName="Star" Property="Visibility" Value="Visible" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                          </DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" IsHitTestVisible="False"
                        Visibility="{Binding HasVisiblePhotos, Converter={StaticResource InverseBoolToVisibility}}">
              <ui:NexIcon Data="{StaticResource Icon.Gallery}" Width="34" Height="34" StrokeThickness="1.2" Foreground="{DynamicResource MutedTextBrush}" />
              <TextBlock Text="{Binding GalleryEmptyText}" Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,12,0,0" />
            </StackPanel>
          </Grid>
        </DockPanel>

        <Rectangle Grid.Column="1" Fill="{DynamicResource BorderBrush}" />
        <GridSplitter Grid.Column="1" Margin="-3,0" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" />

        <!-- ④ Tuval -->
        <Grid x:Name="CanvasArea" Grid.Column="2" Background="{DynamicResource CanvasBackgroundBrush}" AllowDrop="True"
              Focusable="True" FocusVisualStyle="{x:Null}" KeyDown="OnCanvasKeyDown"
              PreviewMouseLeftButtonDown="OnCanvasMouseDown" PreviewMouseMove="OnCanvasMouseMove" PreviewMouseLeftButtonUp="OnCanvasMouseUp"
              PreviewMouseWheel="OnCanvasMouseWheel" DragOver="OnCanvasDragOver" DragLeave="OnCanvasDragLeave" Drop="OnCanvasDrop">
          <ScrollViewer x:Name="CanvasScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False"
                        SizeChanged="OnCanvasScrollerSizeChanged">
            <Grid MinWidth="{Binding ViewportWidth, ElementName=CanvasScroller}" MinHeight="{Binding ViewportHeight, ElementName=CanvasScroller}">
              <Border Margin="40" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Width="{Binding Zoom.DisplayWidth}" Height="{Binding Zoom.DisplayHeight}"
                      Visibility="{Binding Zoom.HasPage, Converter={StaticResource BoolToVisibility}}">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="{DynamicResource PageShadowOpacity}" Color="{DynamicResource ShadowColor}" />
                </Border.Effect>
                <Grid>
                  <!-- Tek sayfa -->
                  <ContentControl Content="{Binding SelectedPage}" ContentTemplate="{StaticResource CanvasPage}" Focusable="False"
                                  Visibility="{Binding IsBookView, Converter={StaticResource InverseBoolToVisibility}}" />
                  <!-- Kitap görünümü: karşılıklı iki sayfa + cilt gölgesi; etkin sayfa ince altın çizgiyle belirtilir -->
                  <Grid Visibility="{Binding IsBookView, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#FBFAF7">
                      <ContentControl Content="{Binding SpreadLeft}" ContentTemplate="{StaticResource CanvasPage}" Focusable="False" />
                    </Border>
                    <Border Grid.Column="1" Background="#FBFAF7">
                      <ContentControl Content="{Binding SpreadRight}" ContentTemplate="{StaticResource CanvasPage}" Focusable="False" />
                    </Border>
                    <Border Grid.Column="0" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0,2,0,0" IsHitTestVisible="False" Opacity="0.9"
                            Visibility="{Binding IsLeftSelected, Converter={StaticResource BoolToVisibility}}" />
                    <Border Grid.Column="1" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0,2,0,0" IsHitTestVisible="False" Opacity="0.9"
                            Visibility="{Binding IsRightSelected, Converter={StaticResource BoolToVisibility}}" />
                    <Grid Grid.ColumnSpan="2" Width="34" HorizontalAlignment="Center" IsHitTestVisible="False">
                      <Rectangle>
                        <Rectangle.Fill>
                          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="#00000000" />
                            <GradientStop Offset="0.42" Color="#1C000000" />
                            <GradientStop Offset="0.5" Color="#42000000" />
                            <GradientStop Offset="0.58" Color="#1C000000" />
                            <GradientStop Offset="1" Color="#00000000" />
                          </LinearGradientBrush>
                        </Rectangle.Fill>
                      </Rectangle>
                      <Rectangle Width="1" Fill="#30000000" />
                    </Grid>
                  </Grid>
                </Grid>
              </Border>
            </Grid>
          </ScrollViewer>

          <!-- Sayfa yokken yol gösterici -->
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380" IsHitTestVisible="False"
                      Visibility="{Binding HasPages, Converter={StaticResource InverseBoolToVisibility}}">
            <Grid Width="64" Height="64" HorizontalAlignment="Center">
              <Ellipse Fill="{DynamicResource SelectionBrush}" />
              <ui:NexIcon Data="{StaticResource Icon.AutoLayout}" Width="28" Height="28" Foreground="{DynamicResource AccentTextBrush}" />
            </Grid>
            <TextBlock Text="Albümünüz burada şekillenecek" Style="{StaticResource Title}" HorizontalAlignment="Center" Margin="0,18,0,0" />
            <TextBlock Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,8,0,0"
                       Text="Fotoğraflarınızı ekleyin, ardından «Oto Oluştur»a basın. Sayfalar seçtiğiniz baskı profilinin ölçüsüyle hazırlanır." />
          </StackPanel>

          <!-- Sol üst: sayfa bilgisi -->
          <Border Style="{StaticResource Pill}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,14,0,0" Padding="12,6"
                  Visibility="{Binding Zoom.HasPage, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
              <ui:NexIcon Data="{StaticResource Icon.Lock}" Width="13" Height="13" Margin="0,0,6,0" Foreground="{DynamicResource AccentTextBrush}"
                          Visibility="{Binding SelectedPage.IsLocked, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
              <TextBlock Text="{Binding SelectedPageInfo}" Foreground="{DynamicResource SecondaryTextBrush}" />
            </StackPanel>
          </Border>

          <!-- Sağ üst: yakınlaştırma -->
          <Border Style="{StaticResource Pill}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,16,0"
                  Visibility="{Binding Zoom.HasPage, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource IconButton}" ui:Ui.Icon="{StaticResource Icon.ZoomOut}" Width="28" Height="28" Command="{Binding Zoom.ZoomOutCommand}" ToolTip="Uzaklaştır (Ctrl+−)" />
              <Button Style="{StaticResource ToolButton}" Content="{Binding Zoom.PercentText}" Command="{Binding Zoom.ActualSizeCommand}" MinWidth="52" MinHeight="28"
                      Padding="6,0" FontSize="12" ToolTip="Gerçek baskı boyutu: %100 (Ctrl+0)" />
              <Button Style="{StaticResource IconButton}" ui:Ui.Icon="{StaticResource Icon.ZoomIn}" Width="28" Height="28" Command="{Binding Zoom.ZoomInCommand}" ToolTip="Yakınlaştır (Ctrl++) · Ctrl + tekerlek" />
              <Rectangle Width="1" Height="16" Margin="4,0" Fill="{DynamicResource BorderBrush}" />
              <Button Style="{StaticResource IconButton}" ui:Ui.Icon="{StaticResource Icon.Fit}" Width="28" Height="28" Command="{Binding Zoom.FitCommand}" ToolTip="Ekrana sığdır (Ctrl+F)" />
            </StackPanel>
          </Border>

          <!-- Alt orta: sayfa gezinme -->
          <Border Style="{StaticResource Pill}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14"
                  Visibility="{Binding Zoom.HasPage, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource IconButton}" ui:Ui.Icon="{StaticResource Icon.ChevronLeft}" Width="28" Height="28" Command="{Binding PreviousPageCommand}" ToolTip="Önceki sayfa (PgUp)" />
              <TextBlock Text="{Binding PageNavText}" VerticalAlignment="Center" Margin="10,0" MinWidth="44" TextAlignment="Center" FontWeight="Medium" />
              <Button Style="{StaticResource IconButton}" ui:Ui.Icon="{StaticResource Icon.ChevronRight}" Width="28" Height="28" Command="{Binding NextPageCommand}" ToolTip="Sonraki sayfa (PgDn)" />
            </StackPanel>
          </Border>
        </Grid>

        <Rectangle Grid.Column="3" Fill="{DynamicResource BorderBrush}" />
        <GridSplitter Grid.Column="3" Margin="-3,0" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" />

        <!-- ⑤ Özellikler: Sayfa · Tasarım · Şablonlar -->
        <TabControl Grid.Column="4" Style="{StaticResource PanelTabs}" SelectedIndex="{Binding PanelTabIndex}">
          <TabItem Header="Sayfa" ui:Ui.Icon="{StaticResource Icon.Page}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="0,0,0,20">
                <DockPanel Style="{StaticResource HeaderRow}">
                  <Button DockPanel.Dock="Right" Command="{Binding ToggleLockCommand}" ToolTip="Kilitli sayfa otomatik oluşturmada değişmez (Ctrl+L)"
                          Padding="10,2" MinHeight="26" FontSize="12">
                    <StackPanel Orientation="Horizontal">
                      <ui:NexIcon Data="{StaticResource Icon.Lock}" Width="13" Height="13" />
                      <TextBlock Text="{Binding LockButtonText}" Margin="6,0,0,0" />
                    </StackPanel>
                  </Button>
                  <TextBlock Text="SAYFA" Style="{StaticResource HeaderText}" />
                </DockPanel>
                <TextBlock Text="{Binding SelectedPageInfo}" Style="{StaticResource SectionText}" />

                <StackPanel Visibility="{Binding HasSelectedSlot, Converter={StaticResource BoolToVisibility}}">
                  <TextBlock Text="SEÇİLİ YUVA" Style="{StaticResource PanelHeader}" />
                  <TextBlock Text="{Binding SelectedSlotInfo}" Style="{StaticResource SectionText}" FontSize="12.5" />
                  <DockPanel Margin="16,10,16,0" IsEnabled="{Binding SelectedSlotHasPhoto}">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding SlotZoomPercent, StringFormat={}%{0:0}}" Width="44" TextAlignment="Right" VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Text="Yakınlaştır" Width="86" VerticalAlignment="Center" />
                    <Slider Minimum="100" Maximum="500" Value="{Binding SlotZoomPercent, Delay=150}" SmallChange="5" LargeChange="25" VerticalAlignment="Center" />
                  </DockPanel>
                  <DockPanel Margin="16,10,16,0" IsEnabled="{Binding SelectedSlotHasPhoto}">
                    <TextBlock Text="Konum" Width="86" VerticalAlignment="Top" Margin="0,4,0,0" />
                    <Grid DockPanel.Dock="Left" Width="78" Height="78" VerticalAlignment="Top">
                      <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                      </Grid.RowDefinitions>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                      </Grid.ColumnDefinitions>
                      <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource AnchorButton}" Command="{Binding AlignPhotoCommand}" CommandParameter="-1 -1"
                              ToolTip="Sol üst: fotoğrafın sol üst bölgesi görünür" AutomationProperties.Name="Sol üst" />
                      <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource AnchorButton}" Command="{Binding AlignPhotoCommand}" CommandParameter="0 -1"
                              ToolTip="Üst orta: fotoğrafın üst orta bölgesi görünür" AutomationProperties.Name="Üst orta" />
                      <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource AnchorButton}" Command="{Binding AlignPhotoCommand}" CommandParameter="1 -1"
                              ToolTip="Sağ üst: fotoğrafın sağ üst bölgesi görünür" AutomationProperties.Name="Sağ üst" />
                      <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource AnchorButton}" Command="{Binding AlignPhotoCommand}" CommandParameter="-1 0"
                              ToolTip="Sol orta: fotoğrafın sol orta bölgesi görünür" AutomationProperties.Name="Sol orta" />
                      <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource AnchorButton}" Command="{Binding AlignPhotoCommand}" CommandParameter="0 0"
                              ToolTip="Orta: fotoğrafın orta bölgesi görünür" AutomationProperties.Name="Orta" />
                      <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource AnchorButton}" Command="{Binding AlignPhotoCommand}" CommandParameter="1 0"
                              ToolTip="Sağ orta: fotoğrafın sağ orta bölgesi görünür" AutomationProperties.Name="Sağ orta" />
                      <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource AnchorButton}" Command="{Binding AlignPhotoCommand}" CommandParameter="-1 1"
                              ToolTip="Sol alt: fotoğrafın sol alt bölgesi görünür" AutomationProperties.Name="Sol alt" />
                      <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource AnchorButton}" Command="{Binding AlignPhotoCommand}" CommandParameter="0 1"
                              ToolTip="Alt orta: fotoğrafın alt orta bölgesi görünür" AutomationProperties.Name="Alt orta" />
                      <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource AnchorButton}" Command="{Binding AlignPhotoCommand}" CommandParameter="1 1"
                              ToolTip="Sağ alt: fotoğrafın sağ alt bölgesi görünür" AutomationProperties.Name="Sağ alt" />
                    </Grid>
                    <StackPanel Margin="12,0,0,0">
                      <ToggleButton Style="{StaticResource ChipToggle}" Content="{Binding PositioningButtonText}" IsChecked="{Binding IsPositioning}"
                                    HorizontalAlignment="Left"
                                    ToolTip="Ya da yuvaya çift tıklayın. Kipteyken düz sürükleme fotoğrafı yuvanın içinde kaydırır." />
                      <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                 Text="Tekerlek: imlecin olduğu yere yakınlaşır · Yön tuşları: kaydırır (Shift: büyük adım) · + / −: yakınlaştırır · Home: ortalar" />
                    </StackPanel>
                  </DockPanel>
                  <WrapPanel Margin="16,10,10,0">
                    <Button Style="{StaticResource SmallButton}" Content="Ortala" Command="{Binding CenterPhotoCommand}" ToolTip="Kaydırma ve yakınlaştırmayı sıfırla" />
                    <Button Style="{StaticResource SmallButton}" Content="{Binding FitButtonText}" Command="{Binding ToggleFitCommand}"
                            ToolTip="Kapla: yuvayı doldurur (kenarlar kırpılır) · Tamamını göster: kırpmadan sığdırır" />
                    <Button Style="{StaticResource SmallButton}" Content="Fotoğrafı çıkar" Command="{Binding ClearSlotCommand}" />
                    <Button Style="{StaticResource SmallButton}" Command="{Binding OpenInEditorCommand}"
                            ToolTip="Photoshop ya da ayarlardaki düzenleyicide açar; kaydedince albüm kendiliğinden güncellenir. Orijinal değişmez.">
                      <StackPanel Orientation="Horizontal">
                        <ui:NexIcon Data="{StaticResource Icon.ExternalLink}" Width="13" Height="13" />
                        <TextBlock Text="Düzenleyicide aç" Margin="6,0,0,0" />
                      </StackPanel>
                    </Button>
                  </WrapPanel>
                  <Border Margin="16,6,16,0" Padding="12,10" CornerRadius="8" Background="{DynamicResource SelectionBrush}"
                          Visibility="{Binding SelectedSlotHasEdit, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                      <TextBlock Text="{Binding SelectedSlotEditInfo}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AccentTextBrush}" />
                      <DockPanel Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right" Content="Düzenlemeyi kaldır" Command="{Binding RemoveEditCommand}" Padding="10,2" MinHeight="26" FontSize="12" />
                        <CheckBox Content="Orijinali göster" IsChecked="{Binding ShowOriginal}" VerticalAlignment="Center" FontSize="12"
                                  ToolTip="Önce/sonra karşılaştırması" />
                      </DockPanel>
                    </StackPanel>
                  </Border>
                  <TextBlock Text="FOTOĞRAF AYARLARI" Style="{StaticResource PanelHeader}" />
                  <StackPanel Margin="16,0,16,0" IsEnabled="{Binding SelectedSlotHasPhoto}">
                    <DockPanel Margin="0,6,0,0" ToolTip="Işık miktarı (±1,5 durak)">
                      <TextBlock DockPanel.Dock="Right" Text="{Binding AdjustExposure, StringFormat={}{0:+0;−0;0}}" Width="40" TextAlignment="Right" VerticalAlignment="Center"
                                 Foreground="{DynamicResource SecondaryTextBrush}" />
                      <TextBlock Text="Pozlama" Width="86" VerticalAlignment="Center" />
                      <Slider Minimum="-100" Maximum="100" Value="{Binding AdjustExposure, Delay=150}" SmallChange="1" LargeChange="10" VerticalAlignment="Center"
                              AutomationProperties.Name="Pozlama" />
                    </DockPanel>
                    <DockPanel Margin="0,6,0,0" ToolTip="Genel aydınlık">
                      <TextBlock DockPanel.Dock="Right" Text="{Binding AdjustBrightness, StringFormat={}{0:+0;−0;0}}" Width="40" TextAlignment="Right" VerticalAlignment="Center"
                                 Foreground="{DynamicResource SecondaryTextBrush}" />
                      <TextBlock Text="Parlaklık" Width="86" VerticalAlignment="Center" />
                      <Slider Minimum="-100" Maximum="100" Value="{Binding AdjustBrightness, Delay=150}" SmallChange="1" LargeChange="10" VerticalAlignment="Center"
                              AutomationProperties.Name="Parlaklık" />
                    </DockPanel>
                    <DockPanel Margin="0,6,0,0" ToolTip="Açık ve koyu arasındaki fark">
                      <TextBlock DockPanel.Dock="Right" Text="{Binding AdjustContrast, StringFormat={}{0:+0;−0;0}}" Width="40" TextAlignment="Right" VerticalAlignment="Center"
                                 Foreground="{DynamicResource SecondaryTextBrush}" />
                      <TextBlock Text="Kontrast" Width="86" VerticalAlignment="Center" />
                      <Slider Minimum="-100" Maximum="100" Value="{Binding AdjustContrast, Delay=150}" SmallChange="1" LargeChange="10" VerticalAlignment="Center"
                              AutomationProperties.Name="Kontrast" />
                    </DockPanel>
                    <DockPanel Margin="0,6,0,0" ToolTip="− soğuk (mavi) · + sıcak (turuncu)">
                      <TextBlock DockPanel.Dock="Right" Text="{Binding AdjustTemperature, StringFormat={}{0:+0;−0;0}}" Width="40" TextAlignment="Right" VerticalAlignment="Center"
                                 Foreground="{DynamicResource SecondaryTextBrush}" />
                      <TextBlock Text="Sıcaklık" Width="86" VerticalAlignment="Center" />
                      <Slider Minimum="-100" Maximum="100" Value="{Binding AdjustTemperature, Delay=150}" SmallChange="1" LargeChange="10" VerticalAlignment="Center"
                              AutomationProperties.Name="Sıcaklık" />
                    </DockPanel>
                    <DockPanel Margin="0,6,0,0" ToolTip="Renk yoğunluğu">
                      <TextBlock DockPanel.Dock="Right" Text="{Binding AdjustSaturation, StringFormat={}{0:+0;−0;0}}" Width="40" TextAlignment="Right" VerticalAlignment="Center"
                                 Foreground="{DynamicResource SecondaryTextBrush}" />
                      <TextBlock Text="Doygunluk" Width="86" VerticalAlignment="Center" />
                      <Slider Minimum="-100" Maximum="100" Value="{Binding AdjustSaturation, Delay=150}" SmallChange="1" LargeChange="10" VerticalAlignment="Center"
                              AutomationProperties.Name="Doygunluk" />
                    </DockPanel>
                    <DockPanel Margin="0,6,0,0" ToolTip="Eğri ufku doğrultur; fotoğraf yuvayı kaplamaya devam eder">
                      <TextBlock DockPanel.Dock="Right" Text="{Binding Straighten, StringFormat={}{0:0.#}°}" Width="40" TextAlignment="Right" VerticalAlignment="Center"
                                 Foreground="{DynamicResource SecondaryTextBrush}" />
                      <TextBlock Text="Düzeltme" Width="86" VerticalAlignment="Center" />
                      <Slider Minimum="-15" Maximum="15" Value="{Binding Straighten, Delay=150}" SmallChange="0.5" LargeChange="2" VerticalAlignment="Center"
                              AutomationProperties.Name="Düzeltme" />
                    </DockPanel>
                    <WrapPanel Margin="0,8,0,0">
                      <ToggleButton Style="{StaticResource ChipToggle}" Content="Siyah-beyaz" IsChecked="{Binding AdjustBlackWhite}" Margin="0,0,6,6" />
                      <ToggleButton Style="{StaticResource ChipToggle}" Content="Öncesi" IsChecked="{Binding CompareAdjustments}" Margin="0,0,6,6"
                                    ToolTip="Ayarlar olmadan nasıl göründüğüne bakın (proje değişmez)" />
                      <Button Style="{StaticResource SmallButton}" Command="{Binding RotateLeftCommand}" ToolTip="Sola 90° döndür (albümün her yerinde)"
                              AutomationProperties.Name="Sola döndür">
                        <ui:NexIcon Data="{StaticResource Icon.RotateLeft}" Width="14" Height="14" />
                      </Button>
                      <Button Style="{StaticResource SmallButton}" Command="{Binding RotateRightCommand}" ToolTip="Sağa 90° döndür (albümün her yerinde)"
                              AutomationProperties.Name="Sağa döndür">
                        <ui:NexIcon Data="{StaticResource Icon.RotateRight}" Width="14" Height="14" />
                      </Button>
                      <Button Style="{StaticResource SmallButton}" Content="Sıfırla" Command="{Binding ResetAdjustmentsCommand}" />
                      <Button Style="{StaticResource SmallButton}" Content="Sayfadakilere uygula" Command="{Binding AdjustmentsToPageCommand}"
                              ToolTip="Bu renk ayarlarını sayfadaki tüm fotoğraflara uygular (tutarlı renk)" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="Orijinal dosya değişmez. Ekranda gördüğünüz ayar PDF'e de aynen girer." />
                  </StackPanel>
                  <TextBlock Style="{StaticResource Caption}" Margin="16,10,16,0"
                             Text="Sürükle: başka yuvaya taşı / yer değiştir · Ctrl + sürükle: yuva içinde kaydır · Tekerlek: yakınlaştır · Galeriden sürükleyerek fotoğraf koyun." />
                </StackPanel>

                <DockPanel Style="{StaticResource HeaderRow}">
                  <Button DockPanel.Dock="Right" Content="Düzenle" Command="{Binding EditProfileCommand}" Padding="10,2" MinHeight="26" FontSize="12" />
                  <TextBlock Text="BASKI PROFİLİ" Style="{StaticResource HeaderText}" />
                </DockPanel>
                <Border Margin="16,0" Style="{StaticResource Card}" Padding="12,10">
                  <TextBlock Text="{Binding ProfileSummary}" TextWrapping="Wrap" FontSize="12.5" LineHeight="20" Foreground="{DynamicResource SecondaryTextBrush}" />
                </Border>

                <DockPanel Style="{StaticResource HeaderRow}">
                  <Button DockPanel.Dock="Right" Content="Denetle" Command="{Binding PreflightCommand}" Padding="10,2" MinHeight="26" FontSize="12" />
                  <TextBlock Text="ÖN KONTROL" Style="{StaticResource HeaderText}" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Issues}" Margin="12,0,12,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <DockPanel Margin="4,5">
                        <ui:NexIcon x:Name="Ic" DockPanel.Dock="Left" Data="{Binding IconKey, Converter={StaticResource ResourceKey}}" Width="16" Height="16"
                                    VerticalAlignment="Top" Margin="0,1,10,0" Foreground="{DynamicResource InfoBrush}" />
                        <StackPanel>
                          <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12.5" />
                          <TextBlock Text="{Binding Suggestion}" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                     Visibility="{Binding HasSuggestion, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                      </DockPanel>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                          <Setter TargetName="Ic" Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsWarning}" Value="True">
                          <Setter TargetName="Ic" Property="Foreground" Value="{DynamicResource WarningBrush}" />
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="Tasarım" ui:Ui.Icon="{StaticResource Icon.Design}" IsEnabled="{Binding HasProject}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="0,0,0,20">
                <TextBlock Text="UYGULAMA KAPSAMI" Style="{StaticResource PanelHeader}" />
                <WrapPanel Margin="16,0,10,0">
                  <RadioButton Style="{StaticResource ChipRadio}" Content="Seçili yuva" IsChecked="{Binding ApplyToSelectedSlot}" GroupName="DesignScope" />
                  <RadioButton Style="{StaticResource ChipRadio}" Content="Seçili sayfa" IsChecked="{Binding ApplyToSelectedPage}" GroupName="DesignScope" />
                  <RadioButton Style="{StaticResource ChipRadio}" Content="Tüm sayfalar" IsChecked="{Binding ApplyToAllPages}" GroupName="DesignScope" />
                </WrapPanel>
                <TextBlock Text="{Binding DesignScopeHint}" Style="{StaticResource Caption}" Margin="16,2,16,0" />

                <TextBlock Text="ÇERÇEVE" Style="{StaticResource PanelHeader}" />
                <ItemsControl ItemsSource="{Binding ClassicFrames}" Margin="12,0">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Style="{StaticResource SwatchButton}" ToolTip="{Binding Name}" CommandParameter="{Binding}"
                              Command="{Binding DataContext.ApplyFrameCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                        <StackPanel Width="92">
                          <Border CornerRadius="4" Background="#F7F4EE">
                            <Viewbox Width="92" Height="66">
                              <Border Padding="7">
                                <ContentControl Content="{Binding Sample}" ContentTemplate="{StaticResource SlotTemplate}" Focusable="False" />
                              </Border>
                            </Viewbox>
                          </Border>
                          <TextBlock Text="{Binding Name}" FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,4,0,1" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="BİÇİMLİ ÇERÇEVELER" Style="{StaticResource PanelHeader}" />
                <TextBlock Text="Yuvanın biçimini değiştirir: kemer, altıgen, elmas, kesik köşe, üçgen, eğik. «Çerçevesiz» şablonun biçimine döndürür."
                           Style="{StaticResource Caption}" Margin="16,-2,16,6" />
                <ItemsControl ItemsSource="{Binding ShapedFrames}" Margin="12,0">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Style="{StaticResource SwatchButton}" ToolTip="{Binding Name}" CommandParameter="{Binding}"
                              Command="{Binding DataContext.ApplyFrameCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                        <StackPanel Width="92">
                          <Border CornerRadius="4" Background="#F7F4EE">
                            <Viewbox Width="92" Height="66">
                              <Border Padding="7">
                                <ContentControl Content="{Binding Sample}" ContentTemplate="{StaticResource SlotTemplate}" Focusable="False" />
                              </Border>
                            </Viewbox>
                          </Border>
                          <TextBlock Text="{Binding Name}" FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,4,0,1" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="FON" Style="{StaticResource PanelHeader}" />
                <DockPanel Margin="16,0,16,6">
                  <TextBlock DockPanel.Dock="Right" Text="{Binding BackgroundOpacity, StringFormat={}{0:P0}}" Width="42" TextAlignment="Right" VerticalAlignment="Center"
                             Foreground="{DynamicResource SecondaryTextBrush}" />
                  <TextBlock Text="Opaklık" VerticalAlignment="Center" Width="86" />
                  <Slider Minimum="0.1" Maximum="1" Value="{Binding BackgroundOpacity}" SmallChange="0.05" LargeChange="0.1"
                          VerticalAlignment="Center" ToolTip="Fon seçmeden önce ayarlayın; görsel fonlarda kâğıt beyazıyla karışır." />
                </DockPanel>

                <TextBlock Text="Düz renkler" Style="{StaticResource Caption}" Margin="16,8,16,4" />
                <ItemsControl ItemsSource="{Binding BackgroundColors}" Margin="12,0">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Style="{StaticResource SwatchButton}" ToolTip="{Binding Name}" CommandParameter="{Binding}" Padding="2"
                              Command="{Binding DataContext.ApplyBackgroundCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                        <Border Width="28" Height="28" CornerRadius="4" Background="{Binding Preview}" />
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <DockPanel Margin="16,8,16,0">
                  <Button DockPanel.Dock="Right" Content="Uygula" Command="{Binding ApplyCustomColorCommand}" Padding="12,2" Margin="8,0,0,0" />
                  <TextBlock Text="Özel renk" VerticalAlignment="Center" Width="86" />
                  <TextBox Text="{Binding CustomColor, UpdateSourceTrigger=PropertyChanged}" ToolTip="#RRGGBB, ör. #F5EFE6" FontFamily="Consolas, Cascadia Mono" />
                </DockPanel>

                <TextBlock Text="Gradyanlar" Style="{StaticResource Caption}" Margin="16,12,16,4" />
                <ItemsControl ItemsSource="{Binding BackgroundGradients}" Margin="12,0">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Style="{StaticResource SwatchButton}" ToolTip="{Binding Name}" CommandParameter="{Binding}" Padding="2"
                              Command="{Binding DataContext.ApplyBackgroundCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                        <Border Width="56" Height="38" CornerRadius="4" Background="{Binding Preview}" />
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <DockPanel Margin="16,14,16,4">
                  <Button DockPanel.Dock="Right" Command="{Binding ImportBackgroundsCommand}" Padding="10,2" MinHeight="26" FontSize="12">
                    <StackPanel Orientation="Horizontal">
                      <ui:NexIcon Data="{StaticResource Icon.Image}" Width="13" Height="13" />
                      <TextBlock Text="Fon görseli ekle…" Margin="6,0,0,0" />
                    </StackPanel>
                  </Button>
                  <TextBlock Text="Görsel fonlar" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                </DockPanel>
                <Border Background="Transparent" AllowDrop="True" DragOver="OnFileDragOver" Drop="OnBackgroundDrop" MinHeight="40"
                        ToolTip="Görselleri Gezgin'den buraya sürükleyip fon olarak ekleyebilirsiniz">
                  <ItemsControl ItemsSource="{Binding BackgroundImages}" Margin="12,0">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Style="{StaticResource SwatchButton}" ToolTip="{Binding Name}" CommandParameter="{Binding}" Padding="2"
                                Command="{Binding DataContext.ApplyBackgroundCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                          <Border Width="68" Height="48" CornerRadius="4" Background="{Binding Preview}" />
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
                <TextBlock Text="Kendi dokularınızı, kâğıt ve desen görsellerinizi ekleyebilirsiniz; fotoğraf galerisine karışmazlar."
                           Style="{StaticResource Caption}" Margin="16,2,16,0"
                           Visibility="{Binding HasBackgroundImages, Converter={StaticResource InverseBoolToVisibility}}" />

                <TextBlock Text="BOŞLUKLAR" Style="{StaticResource PanelHeader}" />
                <DockPanel Margin="16,0">
                  <TextBlock DockPanel.Dock="Right" Text="{Binding GapPercent, StringFormat={}%{0:0.#}}" Width="42" TextAlignment="Right" VerticalAlignment="Center"
                             Foreground="{DynamicResource SecondaryTextBrush}" />
                  <TextBlock Text="Fotoğraf arası" Width="96" VerticalAlignment="Center" />
                  <Slider Minimum="0" Maximum="10" Value="{Binding GapPercent}" SmallChange="0.5" LargeChange="1" IsSnapToTickEnabled="True" TickFrequency="0.5" VerticalAlignment="Center" />
                </DockPanel>
                <DockPanel Margin="16,8,16,0">
                  <TextBlock DockPanel.Dock="Right" Text="{Binding MarginPercent, StringFormat={}%{0:0.#}}" Width="42" TextAlignment="Right" VerticalAlignment="Center"
                             Foreground="{DynamicResource SecondaryTextBrush}" />
                  <TextBlock Text="Sayfa kenarı" Width="96" VerticalAlignment="Center" />
                  <Slider Minimum="0" Maximum="15" Value="{Binding MarginPercent}" SmallChange="0.5" LargeChange="1" IsSnapToTickEnabled="True" TickFrequency="0.5" VerticalAlignment="Center" />
                </DockPanel>
                <WrapPanel Margin="16,12,10,0">
                  <Button Style="{StaticResource SmallButton}" Content="Tüm sayfalara uygula" Command="{Binding ApplySpacingCommand}" />
                  <Button Style="{StaticResource SmallButton}" Content="Şablon varsayılanı" Command="{Binding ResetSpacingCommand}" />
                </WrapPanel>
                <TextBlock Text="{Binding SpacingSummary}" Style="{StaticResource Caption}" Margin="16,2,16,0" />
                <TextBlock Text="Yüzdeler sayfanın kısa kenarına göredir. Kilitli sayfalar değişmez." Style="{StaticResource Caption}" Margin="16,2,16,0" />
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="Şablonlar" ui:Ui.Icon="{StaticResource Icon.Templates}" IsEnabled="{Binding HasProject}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Margin="16,16,16,8">
                <DockPanel>
                  <ComboBox DockPanel.Dock="Right" Width="130" ItemsSource="{Binding TemplateCounts}" SelectedItem="{Binding SelectedTemplateCount}" DisplayMemberPath="Name" />
                  <TextBlock Text="Fotoğraf sayısı" VerticalAlignment="Center" />
                </DockPanel>
                <ListBox ItemsSource="{Binding TemplateStyles}" SelectedItem="{Binding SelectedTemplateStyle}" Margin="-2,12,0,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" Focusable="False">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                      <Setter Property="Cursor" Value="Hand" />
                      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="10,3" Margin="0,0,6,6">
                              <TextBlock x:Name="T" Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                            </Border>
                            <ControlTemplate.Triggers>
                              <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                              </Trigger>
                              <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="T" Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </ListBox.ItemContainerStyle>
                </ListBox>
                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                           Text="Önizlemeler seçili sayfanın fotoğraflarıyla gösterilir. Tıklayınca şablon sayfaya uygulanır; sığmayan fotoğraflar «kullanılmamış» olur." />
              </StackPanel>
              <TextBlock DockPanel.Dock="Top" Text="Bu süzgece uyan şablon yok." Style="{StaticResource Caption}" Margin="16,12"
                         Visibility="{Binding HasTemplates, Converter={StaticResource InverseBoolToVisibility}}" />
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Templates}" Margin="12,0,12,16">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Style="{StaticResource SwatchButton}" ToolTip="{Binding ToolTip}" CommandParameter="{Binding}"
                              Command="{Binding DataContext.ApplyTemplateCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                        <StackPanel Width="96">
                        <Viewbox Width="96" Height="74">
                          <Grid Width="{Binding Width}" Height="{Binding Height}" Background="#FBFAF7">
                            <ItemsControl ItemsSource="{Binding Cells}" Focusable="False">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <Canvas />
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                  <Setter Property="Canvas.Left" Value="{Binding X}" />
                                  <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                </Style>
                              </ItemsControl.ItemContainerStyle>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <Path Data="{Binding Shape}" Fill="{Binding Fill}" />
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </Grid>
                        </Viewbox>
                        <DockPanel Margin="1,4,1,1">
                          <ui:NexIcon DockPanel.Dock="Right" Data="{StaticResource Icon.Shapes}" Width="11" Height="11" Foreground="{DynamicResource AccentTextBrush}"
                                      ToolTip="Geometrik" Visibility="{Binding IsGeometric, Converter={StaticResource BoolToVisibility}}" />
                          <TextBlock Text="{Binding Name}" FontSize="10.5" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>
          </TabItem>
          <TabItem Header="Metin" ui:Ui.Icon="{StaticResource Icon.Type}" IsEnabled="{Binding HasProject}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="0,0,0,20">
                <TextBlock Text="HAZIR STİLLER" Style="{StaticResource PanelHeader}" />
                <TextBlock Text="Seçili sayfaya eklenir; sayfada sürükleyerek taşıyın, çift tıklayıp yazın." Style="{StaticResource Caption}" Margin="16,-2,16,6" />
                <ItemsControl ItemsSource="{Binding TextPresetList}" Margin="12,0">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Style="{StaticResource SwatchButton}" ToolTip="{Binding Name}" CommandParameter="{Binding Preset}" HorizontalContentAlignment="Stretch"
                              Command="{Binding DataContext.AddTextCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                        <StackPanel>
                          <Border CornerRadius="4" Background="#F7F4EE" Height="54" Padding="6,0">
                            <Viewbox StretchDirection="DownOnly" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Sample}" Foreground="{Binding Foreground}" FontSize="20"
                                         FontFamily="{Binding Family}" FontStyle="{Binding Style}" />
                            </Viewbox>
                          </Border>
                          <TextBlock Text="{Binding Name}" FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,4,0,1" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="SEÇİLİ METİN" Style="{StaticResource PanelHeader}" />
                <Border Style="{StaticResource Card}" Margin="16,0,16,0" Padding="14,12"
                        Visibility="{Binding HasSelectedText, Converter={StaticResource InverseBoolToVisibility}}">
                  <StackPanel>
                    <ui:NexIcon Data="{StaticResource Icon.Type}" Width="22" Height="22" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Left" />
                    <TextBlock Text="Bir metin seçin ya da yukarıdan bir stil ekleyin." TextWrapping="Wrap" Margin="0,8,0,0" />
                    <TextBlock Text="Ctrl+T serbest metin ekler · Del seçili metni siler" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                  </StackPanel>
                </Border>
                <StackPanel Visibility="{Binding HasSelectedText, Converter={StaticResource BoolToVisibility}}">
                  <TextBox x:Name="TextContentBox" Margin="16,0,16,8" MinHeight="64" MaxHeight="160" AcceptsReturn="True" TextWrapping="Wrap"
                           VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Metin içeriği"
                           Text="{Binding TextContent, UpdateSourceTrigger=PropertyChanged, Delay=250}" />

                  <DockPanel Margin="16,0,16,8">
                    <TextBlock Text="Yazı tipi" VerticalAlignment="Center" Width="86" />
                    <ComboBox ItemsSource="{Binding FontOptions}" SelectedItem="{Binding TextFont}" AutomationProperties.Name="Yazı tipi">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Kind}" FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock Text="{Binding Family}" FontFamily="{Binding Preview}" FontSize="15" VerticalAlignment="Center" />
                          </DockPanel>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </DockPanel>

                  <DockPanel Margin="16,0,16,6">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding TextSize, StringFormat={}{0:0} pt}" Width="42" TextAlignment="Right" VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Text="Boyut" VerticalAlignment="Center" Width="86" />
                    <Slider Minimum="6" Maximum="144" Value="{Binding TextSize, Delay=120}" SmallChange="1" LargeChange="4" IsSnapToTickEnabled="True" TickFrequency="1"
                            VerticalAlignment="Center" AutomationProperties.Name="Yazı boyutu" />
                  </DockPanel>
                  <DockPanel Margin="16,0,16,6">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding TextLineHeight, StringFormat={}{0:0.00}}" Width="42" TextAlignment="Right" VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Text="Satır aralığı" VerticalAlignment="Center" Width="86" />
                    <Slider Minimum="0.8" Maximum="2.5" Value="{Binding TextLineHeight, Delay=120}" SmallChange="0.05" LargeChange="0.25" IsSnapToTickEnabled="True" TickFrequency="0.05"
                            VerticalAlignment="Center" AutomationProperties.Name="Satır aralığı" />
                  </DockPanel>
                  <DockPanel Margin="16,0,16,6">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding TextLetterSpacing, StringFormat={}%{0:0}}" Width="42" TextAlignment="Right" VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Text="Harf aralığı" VerticalAlignment="Center" Width="86" />
                    <Slider Minimum="-5" Maximum="50" Value="{Binding TextLetterSpacing, Delay=120}" SmallChange="1" LargeChange="5" IsSnapToTickEnabled="True" TickFrequency="1"
                            VerticalAlignment="Center" AutomationProperties.Name="Harf aralığı"
                            ToolTip="Puntonun yüzdesi. Büyük harfli tarih ve isimlerde %15–30 zarif durur." />
                  </DockPanel>
                  <DockPanel Margin="16,0,16,8">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding TextWidthPercent, StringFormat={}%{0:0}}" Width="42" TextAlignment="Right" VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Text="Kutu genişliği" VerticalAlignment="Center" Width="86" />
                    <Slider Minimum="10" Maximum="100" Value="{Binding TextWidthPercent, Delay=120}" SmallChange="1" LargeChange="5" IsSnapToTickEnabled="True" TickFrequency="1"
                            VerticalAlignment="Center" AutomationProperties.Name="Kutu genişliği" />
                  </DockPanel>

                  <StackPanel Orientation="Horizontal" Margin="16,0,16,8">
                    <ToggleButton Style="{StaticResource IconToggle}" ui:Ui.Icon="{StaticResource Icon.Bold}" IsChecked="{Binding TextBold}" ToolTip="Kalın" AutomationProperties.Name="Kalın" />
                    <ToggleButton Style="{StaticResource IconToggle}" ui:Ui.Icon="{StaticResource Icon.Italic}" IsChecked="{Binding TextItalic}" ToolTip="Eğik" AutomationProperties.Name="Eğik" Margin="0,0,14,0" />
                    <RadioButton Style="{StaticResource IconToggle}" ui:Ui.Icon="{StaticResource Icon.AlignLeft}" IsChecked="{Binding IsTextLeft}" GroupName="TextAlign" ToolTip="Sola yasla" AutomationProperties.Name="Sola yasla" />
                    <RadioButton Style="{StaticResource IconToggle}" ui:Ui.Icon="{StaticResource Icon.AlignCenter}" IsChecked="{Binding IsTextCenter}" GroupName="TextAlign" ToolTip="Ortala" AutomationProperties.Name="Ortala" />
                    <RadioButton Style="{StaticResource IconToggle}" ui:Ui.Icon="{StaticResource Icon.AlignRight}" IsChecked="{Binding IsTextRight}" GroupName="TextAlign" ToolTip="Sağa yasla" AutomationProperties.Name="Sağa yasla" />
                  </StackPanel>

                  <TextBlock Text="Renk" Style="{StaticResource Caption}" Margin="16,4,16,4" />
                  <ItemsControl ItemsSource="{Binding TextColors}" Margin="12,0">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Style="{StaticResource SwatchButton}" ToolTip="{Binding Name}" CommandParameter="{Binding}" Padding="2"
                                Command="{Binding DataContext.ApplyTextColorCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                          <Border Width="24" Height="24" CornerRadius="12" Background="{Binding Preview}" BorderThickness="1" BorderBrush="#33000000" />
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <DockPanel Margin="16,8,16,0">
                    <TextBlock Text="Özel renk" VerticalAlignment="Center" Width="86" />
                    <TextBox Text="{Binding TextColorHex, UpdateSourceTrigger=LostFocus}" ToolTip="#RRGGBB, ör. #A9843F" FontFamily="Consolas, Cascadia Mono"
                             AutomationProperties.Name="Özel metin rengi" />
                  </DockPanel>

                  <DockPanel Margin="0,0,16,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Okunur yap" Command="{Binding MakeTextReadableCommand}" VerticalAlignment="Bottom"
                            ToolTip="Yazı rengine göre en uygun etkiyi seçer: koyu yazıya beyaz hale, açık yazıya koyu gölge." />
                    <TextBlock Text="OKUNURLUK" Style="{StaticResource PanelHeader}" />
                  </DockPanel>
                  <ListBox ItemsSource="{Binding TextEffectOptions}" SelectedItem="{Binding SelectedTextEffect}" Margin="12,0,10,0" Focusable="False"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Metin etkisi">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                      </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                      <Style TargetType="ListBoxItem">
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="ToolTip" Value="{Binding Hint}" />
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                              <StackPanel Margin="4,0,4,8">
                                <Border x:Name="Bd" CornerRadius="6" BorderThickness="2" BorderBrush="Transparent" Padding="1">
                                  <!-- Karışık tonlu zemin: etkinin okunurluğa katkısı açık ve koyu bölgede birlikte görülür. -->
                                  <Border CornerRadius="4" Height="50">
                                    <Border.Background>
                                      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#EDE3D1" Offset="0" />
                                        <GradientStop Color="#9C8B76" Offset="0.55" />
                                        <GradientStop Color="#3F3A35" Offset="1" />
                                      </LinearGradientBrush>
                                    </Border.Background>
                                    <Viewbox Margin="4,2">
                                      <ui:AlbumTextView Text="{Binding Preview}" Width="30" Height="14" />
                                    </Viewbox>
                                  </Border>
                                </Border>
                                <TextBlock x:Name="T" Text="{Binding Name}" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                              </StackPanel>
                              <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                  <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                  <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                  <Setter TargetName="T" Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </Style>
                    </ListBox.ItemContainerStyle>
                  </ListBox>
                  <TextBlock Text="{Binding TextEffectHint}" Style="{StaticResource Caption}" Margin="16,0,16,6" TextWrapping="Wrap" />
                  <StackPanel Visibility="{Binding HasTextEffect, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel Margin="16,0,16,6">
                      <TextBlock DockPanel.Dock="Right" Text="{Binding TextEffectStrength, StringFormat={}%{0:0}}" Width="42" TextAlignment="Right" VerticalAlignment="Center"
                                 Foreground="{DynamicResource SecondaryTextBrush}" />
                      <TextBlock Text="Güç" VerticalAlignment="Center" Width="86" />
                      <Slider Minimum="5" Maximum="100" Value="{Binding TextEffectStrength, Delay=120}" SmallChange="5" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="5"
                              VerticalAlignment="Center" AutomationProperties.Name="Etki gücü" />
                    </DockPanel>
                    <DockPanel Margin="16,0,16,0">
                      <TextBlock Text="Etki rengi" VerticalAlignment="Center" Width="86" />
                      <ItemsControl ItemsSource="{Binding TextEffectColors}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Button Style="{StaticResource SwatchButton}" ToolTip="{Binding Name}" CommandParameter="{Binding}" Padding="2"
                                    Command="{Binding DataContext.ApplyTextEffectColorCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                              <Border Width="20" Height="20" CornerRadius="10" Background="{Binding Preview}" BorderThickness="1" BorderBrush="#33000000" />
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </DockPanel>
                    <DockPanel Margin="16,6,16,0">
                      <TextBlock Text="Özel etki rengi" VerticalAlignment="Center" Width="86" TextWrapping="Wrap" />
                      <TextBox Text="{Binding TextEffectColorHex, UpdateSourceTrigger=LostFocus}" ToolTip="#RRGGBB ya da saydamlıkla #RRGGBBAA" FontFamily="Consolas, Cascadia Mono"
                               AutomationProperties.Name="Özel etki rengi" />
                    </DockPanel>
                  </StackPanel>

                  <Button Margin="16,14,16,0" HorizontalAlignment="Left" Style="{StaticResource ToolButton}" Command="{Binding DeleteTextCommand}" ToolTip="Seçili metni sil (Del)">
                    <StackPanel Orientation="Horizontal">
                      <ui:NexIcon Data="{StaticResource Icon.Trash}" Width="15" Height="15" Margin="0,0,6,0" />
                      <TextBlock Text="Metni sil" />
                    </StackPanel>
                  </Button>
                  <TextBlock Text="Metinler yuvaların üstünde durur ve PDF'e gömülü yazı tipiyle aynen çıkar." Style="{StaticResource Caption}" Margin="16,10,16,0" TextWrapping="Wrap" />
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="Hikâye" ui:Ui.Icon="{StaticResource Icon.Story}" IsEnabled="{Binding HasProject}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="0,0,0,20">
                <TextBlock Text="ZAMAN AKIŞI" Style="{StaticResource PanelHeader}" />
                <TextBlock Style="{StaticResource Caption}" Margin="16,-2,16,8" TextWrapping="Wrap"
                           Text="Fotoğraflar çekim saatine göre bölümlere ayrılır: sabah, öğle, akşam; birden çok günde gün adıyla. Her bölüm albümde yeni sayfada başlar. Adları dilediğiniz gibi değiştirin." />
                <DockPanel Margin="16,0,16,6">
                  <TextBlock DockPanel.Dock="Right" Text="{Binding StoryGapMinutes, StringFormat={}{0:0} dk}" Width="46" TextAlignment="Right" VerticalAlignment="Center"
                             Foreground="{DynamicResource SecondaryTextBrush}" />
                  <TextBlock Text="Bölüm arası" VerticalAlignment="Center" Width="86" />
                  <Slider Minimum="10" Maximum="240" Value="{Binding StoryGapMinutes}" SmallChange="5" LargeChange="15" IsSnapToTickEnabled="True" TickFrequency="5"
                          VerticalAlignment="Center" AutomationProperties.Name="Bölüm arası"
                          ToolTip="İki fotoğraf arasında bu kadar süre varsa yeni bölüm başlar. Gün değişimi her zaman böler." />
                </DockPanel>
                <WrapPanel Margin="16,4,12,0">
                  <Button Style="{StaticResource AccentButton}" Command="{Binding DetectStoryCommand}" Margin="0,0,8,8" Padding="12,5">
                    <StackPanel Orientation="Horizontal">
                      <ui:NexIcon Data="{StaticResource Icon.Sparkles}" Width="15" Height="15" Margin="0,0,6,0" />
                      <TextBlock Text="Bölümleri bul" />
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource OutlineAccentButton}" Command="{Binding FilmCommand}" Margin="0,0,8,8" Padding="12,5"
                          ToolTip="Bölümlerden geçiş efektli, müzikli video">
                    <StackPanel Orientation="Horizontal">
                      <ui:NexIcon Data="{StaticResource Icon.Film}" Width="15" Height="15" Margin="0,0,6,0" />
                      <TextBlock Text="Hikâye filmi" />
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource OutlineAccentButton}" Command="{Binding BuildFromStoryCommand}" Margin="0,0,8,8" Padding="12,5"
                          ToolTip="Kilitli olmayan sayfalar bölümlere göre yeniden oluşturulur.">
                    <StackPanel Orientation="Horizontal">
                      <ui:NexIcon Data="{StaticResource Icon.Story}" Width="15" Height="15" Margin="0,0,6,0" />
                      <TextBlock Text="Hikâyeye göre oluştur" />
                    </StackPanel>
                  </Button>
                </WrapPanel>
                <CheckBox Margin="16,2,16,4" IsChecked="{Binding StoryOpeners}" Content="Her bölüm bir açılış sayfasıyla başlasın"
                          ToolTip="Bölümün ilk favorisi (yoksa ilk yatay fotoğrafı) tam sayfa, üzerinde bölüm adı." />
                <CheckBox Margin="16,0,16,8" IsChecked="{Binding StoryEnabled}" Content="«Oto Oluştur» bölümleri kullansın" IsEnabled="{Binding HasStory}" />

                <!-- Boş durum -->
                <Border Style="{StaticResource Card}" Margin="16,4,16,0" Padding="14,12" Visibility="{Binding HasNoStory, Converter={StaticResource BoolToVisibility}}">
                  <StackPanel>
                    <ui:NexIcon Data="{StaticResource Icon.Story}" Width="22" Height="22" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Left" />
                    <TextBlock Text="Henüz bölüm yok." Margin="0,8,0,0" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="«Bölümleri bul» çekim saatlerinden önerir. Galeride bir fotoğrafa sağ tıklayıp «Buradan yeni bölüm» ile elle de başlatabilirsiniz." />
                  </StackPanel>
                </Border>

                <StackPanel Visibility="{Binding HasStory, Converter={StaticResource BoolToVisibility}}">
                  <!-- Zaman çizelgesi: çekim yoğunluğu, bölüm renginde -->
                  <TextBlock Text="ZAMAN ÇİZELGESİ" Style="{StaticResource PanelHeader}" />
                  <Border Margin="16,0,16,0" Height="46" CornerRadius="6" Background="{DynamicResource SurfaceHoverBrush}" Padding="6,4">
                    <ItemsControl ItemsSource="{Binding Timeline}" VerticalAlignment="Bottom">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Height="{Binding Height}" Background="{Binding Color}" CornerRadius="1.5" Margin="0.5,0" VerticalAlignment="Bottom" ToolTip="{Binding ToolTip}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Border>
                  <TextBlock Text="{Binding StorySummary}" Style="{StaticResource Caption}" Margin="16,6,16,0" TextWrapping="Wrap" />

                  <DockPanel Margin="0,0,16,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Bölümleri kaldır" Command="{Binding ClearStoryCommand}" VerticalAlignment="Bottom" />
                    <TextBlock Text="BÖLÜMLER" Style="{StaticResource PanelHeader}" />
                  </DockPanel>
                  <TextBlock Style="{StaticResource Caption}" Margin="16,-2,16,6" TextWrapping="Wrap" Text="Bölüme tıklayınca galeri o bölümün fotoğraflarını gösterir. Adı yazarak ya da listeden seçerek değiştirin." />
                  <ListBox ItemsSource="{Binding Chapters}" SelectedItem="{Binding SelectedChapter}" Margin="12,0,12,0" Focusable="False"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Bölümler">
                    <ListBox.ItemContainerStyle>
                      <Style TargetType="ListBoxItem">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                              <Border x:Name="Bd" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Margin="0,0,0,6" Padding="0,0,8,8"
                                      Background="Transparent">
                                <DockPanel>
                                  <Border DockPanel.Dock="Left" Width="4" CornerRadius="8,0,0,8" Background="{Binding Color}" Margin="0,0,10,-8" />
                                  <StackPanel Margin="0,8,0,0">
                                    <DockPanel>
                                      <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" ui:Ui.Icon="{StaticResource Icon.Merge}" Width="26" Height="26"
                                              Command="{Binding DataContext.MergeChapterCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                              ToolTip="Öncekiyle birleştir (ilk bölümse sonrakini katar)" AutomationProperties.Name="Öncekiyle birleştir" />
                                      <TextBlock DockPanel.Dock="Left" Text="{Binding Number}" Width="18" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" />
                                      <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" ui:Ui.Icon="{StaticResource Icon.ChevronDown}" Width="26" Height="26"
                                              Margin="2,0,0,0" ToolTip="Hazır adlar" AutomationProperties.Name="Hazır adlar" Click="OnChapterNamesClick">
                                        <Button.ContextMenu>
                                          <ContextMenu ItemsSource="{Binding Suggestions}">
                                            <ContextMenu.ItemContainerStyle>
                                              <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                <Setter Property="Header" Value="{Binding Name}" />
                                                <Setter Property="Command" Value="{Binding ApplyCommand}" />
                                              </Style>
                                            </ContextMenu.ItemContainerStyle>
                                          </ContextMenu>
                                        </Button.ContextMenu>
                                      </Button>
                                      <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" Margin="0,0,2,0" VerticalContentAlignment="Center"
                                               AutomationProperties.Name="Bölüm adı" ToolTip="Bölüm adı (açılış sayfasında başlık olur)" />
                                    </DockPanel>
                                    <StackPanel Orientation="Horizontal" Margin="18,6,0,0">
                                      <ui:NexIcon Data="{StaticResource Icon.Clock}" Width="12" Height="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,5,0" />
                                      <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Preview}" Margin="18,6,0,0" Focusable="False">
                                      <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                          <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                      </ItemsControl.ItemsPanel>
                                      <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                          <Border Width="38" Height="38" CornerRadius="4" Margin="0,0,4,0" Background="{DynamicResource SurfaceHoverBrush}" ClipToBounds="True">
                                            <Border CornerRadius="4">
                                              <Border.Background>
                                                <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                                              </Border.Background>
                                            </Border>
                                          </Border>
                                        </DataTemplate>
                                      </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                  </StackPanel>
                                </DockPanel>
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                  <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                  <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                  <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBrush}" />
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </Style>
                    </ListBox.ItemContainerStyle>
                  </ListBox>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
        </TabControl>
      </Grid>

      <Rectangle Grid.Row="3" Fill="{DynamicResource BorderBrush}" />
      <GridSplitter Grid.Row="3" Margin="0,-3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows"
                    ResizeBehavior="PreviousAndNext" Background="Transparent" />

      <!-- ⑥ Sayfa şeridi -->
      <DockPanel Grid.Row="4" Background="{DynamicResource SurfaceBrush}">
        <DockPanel DockPanel.Dock="Top" Margin="16,4,10,0">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Style="{StaticResource IconButton}" ui:Ui.Icon="{StaticResource Icon.PagePlus}" Width="28" Height="28" Command="{Binding AddPageCommand}"
                    ToolTip="Seçili sayfanın arkasına boş sayfa ekle" />
            <Button Style="{StaticResource IconButton}" ui:Ui.Icon="{StaticResource Icon.Restore}" Width="28" Height="28" Command="{Binding DuplicatePageCommand}"
                    ToolTip="Sayfayı çoğalt (Ctrl+D)" />
            <Button Style="{StaticResource IconButton}" ui:Ui.Icon="{StaticResource Icon.ChevronLeft}" Width="28" Height="28" Command="{Binding MovePageLeftCommand}"
                    ToolTip="Sola taşı · sürükleyerek de sıralayabilirsiniz" />
            <Button Style="{StaticResource IconButton}" ui:Ui.Icon="{StaticResource Icon.ChevronRight}" Width="28" Height="28" Command="{Binding MovePageRightCommand}"
                    ToolTip="Sağa taşı · sürükleyerek de sıralayabilirsiniz" />
            <Button Style="{StaticResource IconButton}" ui:Ui.Icon="{StaticResource Icon.Trash}" Width="28" Height="28" Command="{Binding DeletePageCommand}"
                    ToolTip="Sayfayı sil (Ctrl+Z ile geri alınır; kilitli sayfa silinmez)" />
          </StackPanel>
          <TextBlock Text="{Binding PagesHeader}" Style="{StaticResource PanelHeader}" Margin="0" VerticalAlignment="Center" />
        </DockPanel>
        <!-- Sondaki "+" kutusu: albümün sonuna boş sayfa -->
        <Button DockPanel.Dock="Right" Width="60" Height="80" Margin="4,2,14,0" VerticalAlignment="Top" Command="{Binding AddPageCommand}" ToolTip="Sayfa ekle"
                Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Grid Background="Transparent">
                <Rectangle x:Name="Box" RadiusX="6" RadiusY="6" Stroke="{DynamicResource BorderStrongBrush}" StrokeThickness="1.2" StrokeDashArray="4 3" />
                <ui:NexIcon x:Name="Ic" Data="{StaticResource Icon.Plus}" Width="20" Height="20" Foreground="{DynamicResource MutedTextBrush}" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Box" Property="Stroke" Value="{DynamicResource AccentBrush}" />
                  <Setter TargetName="Ic" Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.4" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>
        <ListBox x:Name="PageStrip" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" Padding="10,0"
                 AllowDrop="True" PreviewMouseLeftButtonDown="OnStripMouseDown" PreviewMouseMove="OnStripMouseMove"
                 DragOver="OnStripDragOver" DragLeave="OnStripDragLeave" Drop="OnStripDrop"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
          <ListBox.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Sayfa ekle" Command="{Binding AddPageCommand}" />
              <MenuItem Header="Sayfayı çoğalt" Command="{Binding DuplicatePageCommand}" InputGestureText="Ctrl+D" />
              <Separator />
              <MenuItem Header="Sola taşı" Command="{Binding MovePageLeftCommand}" />
              <MenuItem Header="Sağa taşı" Command="{Binding MovePageRightCommand}" />
              <MenuItem Header="{Binding LockButtonText}" Command="{Binding ToggleLockCommand}" InputGestureText="Ctrl+L" />
              <Separator />
              <MenuItem Header="Sayfayı sil" Command="{Binding DeletePageCommand}" />
            </ContextMenu>
          </ListBox.ContextMenu>
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="FocusVisualStyle" Value="{x:Null}" />
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <StackPanel Margin="6,2" Background="Transparent">
                      <Grid>
                        <Border x:Name="Frame" BorderThickness="2" CornerRadius="4" Padding="1" BorderBrush="Transparent">
                          <ContentPresenter />
                        </Border>
                        <!-- Bölüm başı: bölüm adı ve rengi -->
                        <Border Height="3" CornerRadius="1.5" Margin="4,0,4,-1" VerticalAlignment="Bottom" Background="{Binding ChapterColor}" IsHitTestVisible="False" />
                        <Border CornerRadius="3" Padding="5,1" Margin="5,5,5,0" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#D9111113"
                                IsHitTestVisible="False" Visibility="{Binding HasChapterLabel, Converter={StaticResource BoolToVisibility}}">
                          <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{Binding ChapterColor}" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ChapterLabel}" FontSize="9.5" Foreground="#F2EDE4" TextTrimming="CharacterEllipsis" MaxWidth="90" />
                          </StackPanel>
                        </Border>
                        <!-- Sürükle-bırak: buraya bırakılınca sayfa bu konuma gelir -->
                        <Border x:Name="DropMark" Width="3" CornerRadius="1.5" Margin="-6,0,0,0" HorizontalAlignment="Left"
                                Background="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                      </Grid>
                      <DockPanel Margin="2,4,2,0">
                        <ui:NexIcon DockPanel.Dock="Right" Data="{StaticResource Icon.Lock}" Width="11" Height="11" Foreground="{DynamicResource AccentTextBrush}"
                                    Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibility}}" ToolTip="Kilitli" />
                        <TextBlock x:Name="Number" Text="{Binding Number}" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
                      </DockPanel>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        <Setter TargetName="Number" Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                        <Setter TargetName="Number" Property="FontWeight" Value="SemiBold" />
                      </Trigger>
                      <DataTrigger Binding="{Binding IsDropBefore}" Value="True">
                        <Setter TargetName="DropMark" Property="Visibility" Value="Visible" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsPhotoDropTarget}" Value="True">
                        <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
                        <Setter TargetName="Frame" Property="Background" Value="{DynamicResource SelectionBrush}" />
                      </DataTrigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Width="{Binding ThumbWidth}" Height="76" Background="White">
                <views:PageView />
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <!-- Durum çubuğu (Karar 12 §4.4) -->
      <Border Grid.Row="5" Background="{DynamicResource TitleBarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
        <DockPanel Margin="14,0">
          <TextBlock DockPanel.Dock="Right" Text="{Binding Version}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="14,0,0,0" />
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                      Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}">
            <Ellipse x:Name="SaveDot" Width="6" Height="6" Margin="0,0,6,0">
              <Ellipse.Style>
                <Style TargetType="Ellipse">
                  <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDirty}" Value="True">
                      <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Ellipse.Style>
            </Ellipse>
            <TextBlock Text="{Binding SaveState}" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" />
          </StackPanel>
          <ProgressBar DockPanel.Dock="Right" Width="120" IsIndeterminate="True" Margin="0,0,16,0" VerticalAlignment="Center"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
          <TextBlock Text="{Binding Status}" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>
      </Border>

      <!-- Başlangıç ekranı (Karar 12 §12, Karar 17): proje yokken araç çubuğu, paneller ve şerit yerine -->
      <Grid Grid.Row="1" Grid.RowSpan="4" Background="{DynamicResource CanvasBackgroundBrush}"
            Visibility="{Binding HasNoProject, Converter={StaticResource BoolToVisibility}}">
        <!-- Altın dalga çizgileri (açılış ekranıyla aynı dil) -->
        <Viewbox Stretch="Fill" VerticalAlignment="Bottom" Height="220" IsHitTestVisible="False" Opacity="0.55">
          <Canvas Width="1200" Height="220">
            <Canvas.Resources>
              <LinearGradientBrush x:Key="Wave" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0" Color="#00C99A44" />
                <GradientStop Offset="0.5" Color="#99E2B964" />
                <GradientStop Offset="1" Color="#00C99A44" />
              </LinearGradientBrush>
            </Canvas.Resources>
            <Path Stroke="{StaticResource Wave}" StrokeThickness="1.2" Data="M -20 150 C 220 60, 420 230, 680 140 S 1060 80, 1220 120" />
            <Path Stroke="{StaticResource Wave}" StrokeThickness="0.8" Opacity="0.7" Data="M -20 168 C 230 80, 440 245, 700 158 S 1080 100, 1220 140" />
            <Path Stroke="{StaticResource Wave}" StrokeThickness="0.6" Opacity="0.5" Data="M -20 186 C 240 100, 460 260, 720 176 S 1100 120, 1220 160" />
          </Canvas>
        </Viewbox>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="720" Margin="24,40">
            <Image Source="{StaticResource LogoImage}" Width="92" Height="92" HorizontalAlignment="Center" />
            <ContentControl Style="{StaticResource Wordmark}" FontSize="44" HorizontalAlignment="Center" Margin="0,14,0,0" />
            <TextBlock Text="Fotoğraflarınızı Hikayeye Dönüştürün" FontSize="15" Foreground="{DynamicResource SecondaryTextBrush}"
                       HorizontalAlignment="Center" Margin="0,6,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
              <Rectangle Width="70" Height="1" VerticalAlignment="Center">
                <Rectangle.Fill>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Offset="0" Color="#00C99A44" />
                    <GradientStop Offset="1" Color="#FFC99A44" />
                  </LinearGradientBrush>
                </Rectangle.Fill>
              </Rectangle>
              <ui:NexIcon Data="{StaticResource Icon.Book}" Width="15" Height="15" Margin="10,0" Foreground="{DynamicResource AccentTextBrush}" />
              <Rectangle Width="70" Height="1" VerticalAlignment="Center">
                <Rectangle.Fill>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Offset="0" Color="#FFC99A44" />
                    <GradientStop Offset="1" Color="#00C99A44" />
                  </LinearGradientBrush>
                </Rectangle.Fill>
              </Rectangle>
            </StackPanel>

            <UniformGrid Columns="2" Margin="0,34,0,0">
              <Button Style="{StaticResource StartCard}" Command="{Binding NewCommand}" Margin="0,0,8,0">
                <DockPanel>
                  <Grid DockPanel.Dock="Left" Width="44" Height="44" VerticalAlignment="Top">
                    <Ellipse Fill="{DynamicResource AccentGradientBrush}" />
                    <ui:NexIcon Data="{StaticResource Icon.New}" Width="20" Height="20" Foreground="{DynamicResource OnAccentBrush}" StrokeThickness="1.8" />
                  </Grid>
                  <StackPanel Margin="14,0,0,0">
                    <DockPanel>
                      <Border DockPanel.Dock="Right" Style="{StaticResource KeyBadge}">
                        <TextBlock Text="Ctrl+N" />
                      </Border>
                      <TextBlock Text="Yeni albüm" Style="{StaticResource Title}" FontSize="16" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                               Text="Baskı profilini seçin; sayfa ölçüsü, taşma payı ve güvenli alan profilden gelir." />
                  </StackPanel>
                </DockPanel>
              </Button>
              <Button Style="{StaticResource StartCard}" Command="{Binding OpenCommand}" Margin="8,0,0,0">
                <DockPanel>
                  <Grid DockPanel.Dock="Left" Width="44" Height="44" VerticalAlignment="Top">
                    <Ellipse Fill="{DynamicResource SelectionBrush}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1" />
                    <ui:NexIcon Data="{StaticResource Icon.Open}" Width="20" Height="20" Foreground="{DynamicResource AccentTextBrush}" />
                  </Grid>
                  <StackPanel Margin="14,0,0,0">
                    <DockPanel>
                      <Border DockPanel.Dock="Right" Style="{StaticResource KeyBadge}">
                        <TextBlock Text="Ctrl+O" />
                      </Border>
                      <TextBlock Text="Proje aç" Style="{StaticResource Title}" FontSize="16" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                               Text="Kaydettiğiniz .albumproj dosyasıyla kaldığınız yerden devam edin." />
                  </StackPanel>
                </DockPanel>
              </Button>
            </UniformGrid>

            <StackPanel Margin="0,30,0,0" Visibility="{Binding HasRecentProjects, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="SON PROJELER" Style="{StaticResource PanelHeader}" Margin="4,0,0,8" />
              <Border Style="{StaticResource Card}" Padding="4">
                <ItemsControl ItemsSource="{Binding RecentProjects}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid>
                        <Button Style="{StaticResource RowButton}" CommandParameter="{Binding}" ToolTip="{Binding Path}"
                                Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                          <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding WhenText}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                                       VerticalAlignment="Center" Margin="12,0,36,0" />
                            <ui:NexIcon DockPanel.Dock="Left" Data="{StaticResource Icon.Album}" Width="18" Height="18" Foreground="{DynamicResource AccentTextBrush}" />
                            <StackPanel Margin="12,0,0,0">
                              <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                                <TextBlock Text="  · bulunamadı" FontSize="12" Foreground="{DynamicResource ErrorBrush}"
                                           Visibility="{Binding Exists, Converter={StaticResource InverseBoolToVisibility}}" />
                              </StackPanel>
                              <TextBlock Text="{Binding Folder}" FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                          </DockPanel>
                        </Button>
                        <Button Style="{StaticResource IconButton}" ui:Ui.Icon="{StaticResource Icon.Close}" Width="26" Height="26"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Listeden kaldır (dosya silinmez)"
                                CommandParameter="{Binding}" Command="{Binding DataContext.ForgetRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </StackPanel>

            <!-- Üç adım -->
            <UniformGrid Columns="3" Margin="0,30,0,0">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <ui:NexIcon Data="{StaticResource Icon.AddPhotos}" Width="16" Height="16" Foreground="{DynamicResource AccentTextBrush}" />
                <TextBlock Text="1  Fotoğrafları ekleyin" Margin="8,0,0,0" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <ui:NexIcon Data="{StaticResource Icon.AutoLayout}" Width="16" Height="16" Foreground="{DynamicResource AccentTextBrush}" />
                <TextBlock Text="2  Oto Oluştur" Margin="8,0,0,0" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <ui:NexIcon Data="{StaticResource Icon.Export}" Width="16" Height="16" Foreground="{DynamicResource AccentTextBrush}" />
                <TextBlock Text="3  Baskı PDF'i alın" Margin="8,0,0,0" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
              </StackPanel>
            </UniformGrid>
            <TextBlock Text="Ücretsiz ve açık kaynak · Hesap, bulut ve abonelik yok · Verileriniz bilgisayarınızda kalır"
                       Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,18,0,0" Foreground="{DynamicResource MutedTextBrush}" />
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- Komut paleti (Ctrl+K) -->
      <Grid x:Name="PaletteOverlay" Grid.RowSpan="6" Background="{DynamicResource OverlayBrush}"
            Visibility="{Binding Palette.IsOpen, Converter={StaticResource BoolToVisibility}}"
            MouseLeftButtonDown="OnPaletteBackdropDown" IsVisibleChanged="OnPaletteVisibleChanged">
        <Border Width="620" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,84,0,40" Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="14" MouseLeftButtonDown="OnPaletteCardDown">
          <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="10" Direction="270" Opacity="0.5" Color="Black" />
          </Border.Effect>
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="16,10,12,10">
              <Border DockPanel.Dock="Right" Style="{StaticResource KeyBadge}">
                <TextBlock Text="Esc" />
              </Border>
              <ui:NexIcon DockPanel.Dock="Left" Data="{StaticResource Icon.Search}" Width="18" Height="18" Foreground="{DynamicResource AccentTextBrush}" />
              <TextBox x:Name="PaletteBox" Text="{Binding Palette.Query, UpdateSourceTrigger=PropertyChanged}" FontSize="15" Margin="6,0"
                       Background="Transparent" BorderThickness="0" PreviewKeyDown="OnPaletteKeyDown"
                       AutomationProperties.Name="Komut ara" />
            </DockPanel>
            <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource BorderBrush}" />
            <DockPanel DockPanel.Dock="Bottom" Margin="16,8">
              <TextBlock DockPanel.Dock="Right" Text="Ctrl+K ile her yerden açılır" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
              <TextBlock Text="↑ ↓ gezin   ·   Enter çalıştır   ·   Esc kapat" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
            </DockPanel>
            <Border DockPanel.Dock="Bottom" Height="1" Background="{DynamicResource BorderBrush}" />
            <Grid>
              <ListBox x:Name="PaletteList" ItemsSource="{Binding Palette.Results}" SelectedItem="{Binding Palette.Selected}" MaxHeight="400" Margin="6"
                       PreviewMouseLeftButtonUp="OnPaletteItemClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="Padding" Value="10,8" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Cursor" Value="Hand" />
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <DockPanel x:Name="Row">
                      <Border DockPanel.Dock="Right" Style="{StaticResource KeyBadge}" Margin="10,0,0,0"
                              Visibility="{Binding Command.HasShortcut, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding Command.Shortcut}" />
                      </Border>
                      <TextBlock DockPanel.Dock="Right" Text="{Binding Command.Category}" FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                      <ui:NexIcon x:Name="Ic" DockPanel.Dock="Left" Data="{Binding Command.IconKey, Converter={StaticResource ResourceKey}}" Width="17" Height="17"
                                  Foreground="{DynamicResource SecondaryTextBrush}" />
                      <TextBlock Text="{Binding Command.Title}" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13.5" />
                    </DockPanel>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter TargetName="Ic" Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                        <Setter TargetName="Row" Property="Opacity" Value="0.4" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Text="Eşleşen komut yok." Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,24"
                         Visibility="{Binding Palette.HasResults, Converter={StaticResource InverseBoolToVisibility}}" />
            </Grid>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
