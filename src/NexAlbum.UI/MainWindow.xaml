<Window x:Class="NexAlbum.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:NexAlbum.UI.Views"
        Title="{Binding Title}"
        Width="1440" Height="900" MinWidth="1024" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        FontFamily="Inter, Segoe UI" FontSize="14"
        Background="{StaticResource BackgroundBrush}">
  <!-- Karar 12 §10 kısayolları -->
  <Window.InputBindings>
    <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}" />
    <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}" />
    <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
    <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsCommand}" />
    <KeyBinding Key="G" Modifiers="Control" Command="{Binding AutoLayoutCommand}" />
    <KeyBinding Key="L" Modifiers="Control" Command="{Binding ToggleLockCommand}" />
    <KeyBinding Key="E" Modifiers="Control" Command="{Binding ExportPdfCommand}" />
    <KeyBinding Key="PageUp" Command="{Binding PreviousPageCommand}" />
    <KeyBinding Key="PageDown" Command="{Binding NextPageCommand}" />
    <KeyBinding Key="F1" Command="{Binding AboutCommand}" />
  </Window.InputBindings>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="52" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="150" MinHeight="90" MaxHeight="240" />
      <RowDefinition Height="26" />
    </Grid.RowDefinitions>

    <!-- ① Üst araç çubuğu -->
    <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
      <DockPanel Margin="8,0" LastChildFill="False">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="30" Height="30" CornerRadius="6" Background="{StaticResource AccentBrush}" Margin="4,0,10,0">
            <TextBlock Text="NA" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <Button Style="{StaticResource ToolButton}" Command="{Binding NewCommand}" ToolTip="Yeni proje (Ctrl+N)">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;" VerticalAlignment="Center" Margin="0,0,6,0" />
              <TextBlock Text="Yeni" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource ToolButton}" Command="{Binding OpenCommand}" ToolTip="Proje aç (Ctrl+O)">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE838;" VerticalAlignment="Center" Margin="0,0,6,0" />
              <TextBlock Text="Aç" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource ToolButton}" Command="{Binding SaveCommand}" ToolTip="Kaydet (Ctrl+S)">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74E;" VerticalAlignment="Center" Margin="0,0,6,0" />
              <TextBlock Text="Kaydet" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource ToolButton}" Command="{Binding SaveAsCommand}" ToolTip="Farklı kaydet (Ctrl+Shift+S)" Content="Farklı kaydet" />
          <Rectangle Width="1" Height="26" Fill="{StaticResource BorderBrush}" Margin="8,0" />
          <Button Style="{StaticResource ToolButton}" Command="{Binding ImportFilesCommand}" ToolTip="Fotoğraf dosyalarını seç (Ctrl/Shift ile birden çok). Gezgin'den sürükleyip bırakmak da olur.">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE91B;" VerticalAlignment="Center" Margin="0,0,6,0" />
              <TextBlock Text="Fotoğraf ekle" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource ToolButton}" Command="{Binding ImportCommand}" ToolTip="Bir klasördeki tüm fotoğrafları ekle (alt klasörler dahil)">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8B7;" VerticalAlignment="Center" Margin="0,0,6,0" />
              <TextBlock Text="Klasör" />
            </StackPanel>
          </Button>
          <Rectangle Width="1" Height="26" Fill="{StaticResource BorderBrush}" Margin="8,0" />
          <ComboBox ItemsSource="{Binding LayoutModes}" SelectedItem="{Binding SelectedMode}" DisplayMemberPath="Name"
                    Width="110" VerticalAlignment="Center" Margin="2,0" ToolTip="Üretim modu (Karar 10 §13)" />
          <Button Style="{StaticResource AccentButton}" Command="{Binding AutoLayoutCommand}" ToolTip="Otomatik oluştur (Ctrl+G)">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE945;" VerticalAlignment="Center" Margin="0,0,6,0" />
              <TextBlock Text="Oto Oluştur" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource ToolButton}" Command="{Binding ShuffleCommand}" ToolTip="Aynı fotoğraflarla farklı bir düzen dene" Content="Farklı sonuç" />
          <Rectangle Width="1" Height="26" Fill="{StaticResource BorderBrush}" Margin="8,0" />
          <Button Style="{StaticResource ToolButton}" Command="{Binding EditProfileCommand}" ToolTip="Baskı profilini düzenle (taşma payı, güvenli alan, DPI…)">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE713;" VerticalAlignment="Center" Margin="0,0,6,0" />
              <TextBlock Text="Profil" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource ToolButton}" Command="{Binding PreflightCommand}" ToolTip="Baskı öncesi kontrol">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE930;" VerticalAlignment="Center" Margin="0,0,6,0" />
              <TextBlock Text="Ön kontrol" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource ToolButton}" Command="{Binding ExportPdfCommand}" ToolTip="Baskı PDF'i (Ctrl+E)">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE749;" VerticalAlignment="Center" Margin="0,0,6,0" />
              <TextBlock Text="PDF Çıktı" />
            </StackPanel>
          </Button>
        </StackPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Command="{Binding AboutCommand}" ToolTip="Hakkında (F1)" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE946;" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBlock Text="Hakkında" />
          </StackPanel>
        </Button>
      </DockPanel>
    </Border>

    <!-- Orta bölge: ② galeri | ③ tuval | ④ özellikler -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280" MinWidth="200" MaxWidth="500" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="*" MinWidth="400" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="340" MinWidth="260" MaxWidth="560" />
      </Grid.ColumnDefinitions>

      <!-- ② Galeri -->
      <DockPanel Grid.Column="0" Background="{StaticResource SurfaceBrush}">
        <TextBlock DockPanel.Dock="Top" Text="Galeri" Style="{StaticResource PanelHeader}" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding PhotoSummary}" Style="{StaticResource Caption}" Margin="12,0,12,8" />
        <Grid>
          <ListBox x:Name="Gallery" ItemsSource="{Binding Assets}" BorderThickness="0" Background="Transparent"
                   AllowDrop="True" DragOver="OnFileDragOver" Drop="OnGalleryDrop"
                   PreviewMouseLeftButtonDown="OnGalleryMouseDown" PreviewMouseMove="OnGalleryMouseMove" MouseDoubleClick="OnGalleryDoubleClick"
                   ToolTip="Fotoğrafı tuvaldeki bir yuvaya sürükleyin ya da çift tıklayın (seçili/ilk boş yuvaya gider)"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="2">
                  <Border DockPanel.Dock="Left" Width="64" Height="64" Background="#E0E0E0" ClipToBounds="True">
                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                  </Border>
                  <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Details}" Style="{StaticResource Caption}" />
                    <TextBlock Text="Albümde" Foreground="{StaticResource SuccessBrush}" FontSize="11"
                               Visibility="{Binding IsUsed, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="Dosya bulunamadı" Foreground="{StaticResource ErrorBrush}" FontSize="11"
                               Visibility="{Binding IsMissing, Converter={StaticResource BoolToVisibility}}" />
                  </StackPanel>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="Henüz fotoğraf yok.&#x0a;«Fotoğraf ekle» ya da «Klasör» ile seçin&#x0a;veya Gezgin'den buraya sürükleyin." IsHitTestVisible="False"
                     Style="{StaticResource Caption}" TextAlignment="Center" Margin="16"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Visibility="{Binding HasPhotos, Converter={StaticResource InverseBoolToVisibility}}" />
        </Grid>
      </DockPanel>

      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}" />

      <!-- ③ Tuval -->
      <Grid x:Name="CanvasArea" Grid.Column="2" Background="{StaticResource CanvasBackgroundBrush}" AllowDrop="True"
            PreviewMouseLeftButtonDown="OnCanvasMouseDown" PreviewMouseMove="OnCanvasMouseMove" PreviewMouseLeftButtonUp="OnCanvasMouseUp"
            PreviewMouseWheel="OnCanvasMouseWheel" DragOver="OnCanvasDragOver" DragLeave="OnCanvasDragLeave" Drop="OnCanvasDrop">
        <Border Margin="32,32,32,64" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.25" />
          </Border.Effect>
          <ContentControl Content="{Binding SelectedPage}" Focusable="False">
            <ContentControl.ContentTemplate>
              <DataTemplate>
                <views:PageView />
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16">
          <Button Style="{StaticResource ToolButton}" Command="{Binding PreviousPageCommand}" ToolTip="Önceki sayfa (PgUp)">
            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE76B;" />
          </Button>
          <TextBlock Text="{Binding SelectedPageInfo}" VerticalAlignment="Center" Margin="12,0" />
          <Button Style="{StaticResource ToolButton}" Command="{Binding NextPageCommand}" ToolTip="Sonraki sayfa (PgDn)">
            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE76C;" />
          </Button>
        </StackPanel>

        <!-- Karşılama (Karar 12 §12) -->
        <Border Background="{StaticResource CanvasBackgroundBrush}"
                Visibility="{Binding HasNoProject, Converter={StaticResource BoolToVisibility}}">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
            <TextBlock Text="NexAlbum'e hoş geldiniz" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Margin="0,12,0,24" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"
                       Text="Bir baskı profili seçerek yeni proje oluşturun, fotoğraflarınızı ekleyin ve «Oto Oluştur» ile albümünüzü saniyeler içinde hazırlayın." />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <Button Style="{StaticResource AccentButton}" Command="{Binding NewCommand}" Content="Yeni proje" Padding="20,8" Margin="0,0,8,0" />
              <Button Style="{StaticResource ToolButton}" Command="{Binding OpenCommand}" Content="Proje aç" Padding="20,8" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}" />

      <!-- ④ Özellikler: Sayfa · Tasarım · Şablonlar -->
      <TabControl Grid.Column="4" Background="{StaticResource SurfaceBrush}" BorderThickness="0" Padding="0">
        <TabItem Header="Sayfa">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock Text="Sayfa" Style="{StaticResource PanelHeader}" />
                <TextBlock Text="{Binding SelectedPageInfo}" TextWrapping="Wrap" Margin="12,0" />
                <Button Content="{Binding LockButtonText}" Command="{Binding ToggleLockCommand}" HorizontalAlignment="Left"
                        Margin="12,8" Padding="12,4" ToolTip="Kilitli sayfa otomatik oluşturmada değişmez (Ctrl+L)" />

                <StackPanel Visibility="{Binding HasSelectedSlot, Converter={StaticResource BoolToVisibility}}">
                  <TextBlock Text="Seçili yuva" Style="{StaticResource PanelHeader}" />
                  <TextBlock Text="{Binding SelectedSlotInfo}" TextWrapping="Wrap" Margin="12,0" FontSize="13" />
                  <DockPanel Margin="12,8,12,0" IsEnabled="{Binding SelectedSlotHasPhoto}">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding SlotZoomPercent, StringFormat={}%{0:0}}" Width="44" TextAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Text="Yakınlaştır" Width="80" VerticalAlignment="Center" />
                    <Slider Minimum="100" Maximum="500" Value="{Binding SlotZoomPercent, Delay=150}" SmallChange="5" LargeChange="25" VerticalAlignment="Center" />
                  </DockPanel>
                  <WrapPanel Margin="10,6,10,0">
                    <Button Content="Ortala" Command="{Binding CenterPhotoCommand}" Padding="10,2" Margin="2" ToolTip="Kaydırma ve yakınlaştırmayı sıfırla" />
                    <Button Content="{Binding FitButtonText}" Command="{Binding ToggleFitCommand}" Padding="10,2" Margin="2" ToolTip="Kapla: yuvayı doldurur (kenarlar kırpılır) · Tamamını göster: kırpmadan sığdırır" />
                    <Button Content="Fotoğrafı çıkar" Command="{Binding ClearSlotCommand}" Padding="10,2" Margin="2" />
                  </WrapPanel>
                  <TextBlock Style="{StaticResource Caption}" Margin="12,6,12,0"
                             Text="Sürükle: başka yuvaya taşı / yer değiştir · Ctrl + sürükle: yuva içinde kaydır · Tekerlek: yakınlaştır · Galeriden sürükleyerek fotoğraf koyun." />
                </StackPanel>

                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="Düzenle" Command="{Binding EditProfileCommand}" Margin="0,8,12,0" Padding="10,2" />
                  <TextBlock Text="Profil" Style="{StaticResource PanelHeader}" />
                </DockPanel>
                <TextBlock Text="{Binding ProfileSummary}" TextWrapping="Wrap" Margin="12,0" FontSize="13" LineHeight="20" />

                <DockPanel Margin="0,8,0,0">
                  <Button DockPanel.Dock="Right" Content="Denetle" Command="{Binding PreflightCommand}" Margin="0,8,12,0" Padding="10,2" />
                  <TextBlock Text="Ön kontrol" Style="{StaticResource PanelHeader}" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Issues}" Margin="8,0,8,16">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <DockPanel Margin="4,4">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Symbol}" Foreground="{Binding SeverityBrush}" Width="18" FontWeight="Bold" />
                        <StackPanel>
                          <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="13" />
                          <TextBlock Text="{Binding Suggestion}" Style="{StaticResource Caption}"
                                     Visibility="{Binding HasSuggestion, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Tasarım" IsEnabled="{Binding HasProject}">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,16">
              <TextBlock Text="Uygulama kapsamı" Style="{StaticResource PanelHeader}" />
              <StackPanel Orientation="Horizontal" Margin="12,0">
                <RadioButton Content="Seçili yuva" IsChecked="{Binding ApplyToSelectedSlot}" Margin="0,0,12,0" GroupName="DesignScope" />
                <RadioButton Content="Seçili sayfa" IsChecked="{Binding ApplyToSelectedPage}" Margin="0,0,12,0" GroupName="DesignScope" />
                <RadioButton Content="Tüm sayfalar" IsChecked="{Binding ApplyToAllPages}" GroupName="DesignScope" />
              </StackPanel>
              <TextBlock Text="{Binding DesignScopeHint}" Style="{StaticResource Caption}" Margin="12,4,12,0" />

              <TextBlock Text="Çerçeve" Style="{StaticResource PanelHeader}" />
              <ItemsControl ItemsSource="{Binding Frames}" Margin="8,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource SwatchButton}" ToolTip="{Binding Name}" CommandParameter="{Binding}"
                            Command="{Binding DataContext.ApplyFrameCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                      <StackPanel Width="88">
                        <Viewbox Width="88" Height="66">
                          <Border Padding="7" Background="#FAFAFA">
                            <ContentControl Content="{Binding Sample}" ContentTemplate="{StaticResource SlotTemplate}" Focusable="False" />
                          </Border>
                        </Viewbox>
                        <TextBlock Text="{Binding Name}" FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="Fon" Style="{StaticResource PanelHeader}" />
              <DockPanel Margin="12,0,12,4">
                <TextBlock DockPanel.Dock="Right" Text="{Binding BackgroundOpacity, StringFormat={}{0:P0}}" Width="42" TextAlignment="Right" VerticalAlignment="Center" />
                <TextBlock Text="Opaklık" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Slider Minimum="0.1" Maximum="1" Value="{Binding BackgroundOpacity}" SmallChange="0.05" LargeChange="0.1"
                        VerticalAlignment="Center" ToolTip="Fon seçmeden önce ayarlayın; görsel fonlarda kâğıt beyazıyla karışır." />
              </DockPanel>

              <TextBlock Text="Düz renkler" Style="{StaticResource Caption}" Margin="12,6,12,2" />
              <ItemsControl ItemsSource="{Binding BackgroundColors}" Margin="8,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource SwatchButton}" ToolTip="{Binding Name}" CommandParameter="{Binding}"
                            Command="{Binding DataContext.ApplyBackgroundCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                      <Border Width="30" Height="30" Background="{Binding Preview}" />
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <DockPanel Margin="12,4,12,0">
                <Button DockPanel.Dock="Right" Content="Uygula" Command="{Binding ApplyCustomColorCommand}" Padding="10,2" Margin="6,0,0,0" />
                <TextBlock Text="Özel renk" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Text="{Binding CustomColor, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" ToolTip="#RRGGBB, ör. #F5EFE6" />
              </DockPanel>

              <TextBlock Text="Gradyanlar" Style="{StaticResource Caption}" Margin="12,8,12,2" />
              <ItemsControl ItemsSource="{Binding BackgroundGradients}" Margin="8,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource SwatchButton}" ToolTip="{Binding Name}" CommandParameter="{Binding}"
                            Command="{Binding DataContext.ApplyBackgroundCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                      <Border Width="54" Height="38" Background="{Binding Preview}" />
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <DockPanel Margin="12,8,12,2">
                <Button DockPanel.Dock="Right" Content="Fon görseli ekle…" Command="{Binding ImportBackgroundsCommand}" Padding="10,2" />
                <TextBlock Text="Görsel fonlar" Style="{StaticResource Caption}" VerticalAlignment="Center" />
              </DockPanel>
              <Border Background="Transparent" AllowDrop="True" DragOver="OnFileDragOver" Drop="OnBackgroundDrop" MinHeight="40"
                      ToolTip="Görselleri Gezgin'den buraya sürükleyip fon olarak ekleyebilirsiniz">
                <ItemsControl ItemsSource="{Binding BackgroundImages}" Margin="8,0">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Style="{StaticResource SwatchButton}" ToolTip="{Binding Name}" CommandParameter="{Binding}"
                              Command="{Binding DataContext.ApplyBackgroundCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                        <Border Width="66" Height="48" Background="{Binding Preview}" />
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
              <TextBlock Text="Kendi dokularınızı, kâğıt ve desen görsellerinizi ekleyebilirsiniz; fotoğraf galerisine karışmazlar."
                         Style="{StaticResource Caption}" Margin="12,2,12,0"
                         Visibility="{Binding HasBackgroundImages, Converter={StaticResource InverseBoolToVisibility}}" />

              <TextBlock Text="Boşluklar" Style="{StaticResource PanelHeader}" />
              <DockPanel Margin="12,0">
                <TextBlock DockPanel.Dock="Right" Text="{Binding GapPercent, StringFormat={}%{0:0.#}}" Width="42" TextAlignment="Right" VerticalAlignment="Center" />
                <TextBlock Text="Fotoğraf arası" Width="96" VerticalAlignment="Center" />
                <Slider Minimum="0" Maximum="10" Value="{Binding GapPercent}" SmallChange="0.5" LargeChange="1" IsSnapToTickEnabled="True" TickFrequency="0.5" VerticalAlignment="Center" />
              </DockPanel>
              <DockPanel Margin="12,4,12,0">
                <TextBlock DockPanel.Dock="Right" Text="{Binding MarginPercent, StringFormat={}%{0:0.#}}" Width="42" TextAlignment="Right" VerticalAlignment="Center" />
                <TextBlock Text="Sayfa kenarı" Width="96" VerticalAlignment="Center" />
                <Slider Minimum="0" Maximum="15" Value="{Binding MarginPercent}" SmallChange="0.5" LargeChange="1" IsSnapToTickEnabled="True" TickFrequency="0.5" VerticalAlignment="Center" />
              </DockPanel>
              <StackPanel Orientation="Horizontal" Margin="12,8,12,0">
                <Button Content="Tüm sayfalara uygula" Command="{Binding ApplySpacingCommand}" Padding="10,2" Margin="0,0,6,0" />
                <Button Content="Şablon varsayılanı" Command="{Binding ResetSpacingCommand}" Padding="10,2" />
              </StackPanel>
              <TextBlock Text="{Binding SpacingSummary}" Style="{StaticResource Caption}" Margin="12,4,12,0" />
              <TextBlock Text="Yüzdeler sayfanın kısa kenarına göredir. Kilitli sayfalar değişmez." Style="{StaticResource Caption}" Margin="12,2,12,0" />
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Şablonlar" IsEnabled="{Binding HasProject}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="12,10,12,6">
              <DockPanel>
                <ComboBox DockPanel.Dock="Right" Width="120" ItemsSource="{Binding TemplateCounts}" SelectedItem="{Binding SelectedTemplateCount}" DisplayMemberPath="Name" />
                <TextBlock Text="Fotoğraf sayısı" VerticalAlignment="Center" />
              </DockPanel>
              <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                         Text="Seçili sayfaya uygulamak için bir şablona tıklayın. Fotoğraflar korunur; sığmayanlar «kullanılmamış» olur." />
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Templates}" Margin="8,0,8,12">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource SwatchButton}" ToolTip="{Binding ToolTip}" CommandParameter="{Binding}"
                            Command="{Binding DataContext.ApplyTemplateCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                      <Viewbox Width="92" Height="70">
                        <Grid Width="{Binding Width}" Height="{Binding Height}" Background="White">
                          <ItemsControl ItemsSource="{Binding Cells}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <Canvas />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                              <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}" />
                                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                              </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Path Data="{Binding Shape}" Fill="#B0BEC5" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </Grid>
                      </Viewbox>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </TabItem>
      </TabControl>
    </Grid>

    <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" ResizeDirection="Rows" Background="{StaticResource BorderBrush}" />

    <!-- ⑤ Sayfa şeridi -->
    <ListBox Grid.Row="3" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}"
             Background="{StaticResource SurfaceBrush}" BorderThickness="0"
             ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Auto"
             ScrollViewer.CanContentScroll="True"
             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <DockPanel Margin="4">
            <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
              <TextBlock DockPanel.Dock="Right" FontFamily="{StaticResource IconFont}" Text="&#xE72E;" FontSize="12"
                         Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibility}}" ToolTip="Kilitli" />
              <TextBlock Text="{Binding Number}" FontSize="12" HorizontalAlignment="Center" />
            </DockPanel>
            <Border Height="96" Width="96" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
              <views:PageView />
            </Border>
          </DockPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- Durum çubuğu (Karar 12 §4.4) -->
    <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
      <DockPanel Margin="10,0">
        <TextBlock DockPanel.Dock="Right" Text="{Binding Version}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0" />
        <TextBlock DockPanel.Dock="Right" Text="{Binding SaveState}" FontSize="12" VerticalAlignment="Center" />
        <ProgressBar DockPanel.Dock="Right" Width="120" Height="8" IsIndeterminate="True" Margin="0,0,12,0" VerticalAlignment="Center"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
        <TextBlock Text="{Binding Status}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>
  </Grid>
</Window>
