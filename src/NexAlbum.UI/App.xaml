<Application x:Class="NexAlbum.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:NexAlbum.UI.Converters"
             xmlns:ui="clr-namespace:NexAlbum.UI.Controls"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- İlk sözlük renk paletidir; ThemeService onu Gece ↔ Fildişi arasında değiştirir (Karar 17 §4). -->
        <ResourceDictionary Source="/NexAlbum;component/Themes/Gece.xaml" />
        <ResourceDictionary Source="/NexAlbum;component/Themes/Icons.xaml" />
        <ResourceDictionary Source="/NexAlbum;component/Themes/Brand.xaml" />
        <ResourceDictionary Source="/NexAlbum;component/Themes/Controls.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
      <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
      <converters:ResourceKeyConverter x:Key="ResourceKey" />

      <!-- Fotoğraf yuvası (birim mm): gölgeli biçim + paspartu, biçime kırpılmış fotoğraf, üstte kontur. PDF ile aynı sıra. -->
      <DataTemplate x:Key="SlotTemplate">
        <Canvas Width="{Binding Width}" Height="{Binding Height}">
          <Path Data="{Binding OuterGeometry}" Fill="{Binding ShapeFill}" Effect="{Binding Shadow}" />
          <!-- Konumlandırma kipi: fotoğrafın yuva dışında kalan kısmı soluk gösterilir (neyin kırpıldığı görülsün). -->
          <Canvas Canvas.Left="{Binding PhotoX}" Canvas.Top="{Binding PhotoY}" IsHitTestVisible="False" Opacity="0.38"
                  Visibility="{Binding IsPositioning, Converter={StaticResource BoolToVisibility}}">
            <Image Source="{Binding Image}" Stretch="Fill"
                   Canvas.Left="{Binding ImageX}" Canvas.Top="{Binding ImageY}"
                   Width="{Binding ImageWidth}" Height="{Binding ImageHeight}" RenderTransformOrigin="0.5,0.5">
              <Image.RenderTransform>
                <RotateTransform Angle="{Binding ImageRotation}" />
              </Image.RenderTransform>
            </Image>
          </Canvas>
          <Grid Canvas.Left="{Binding PhotoX}" Canvas.Top="{Binding PhotoY}"
                Width="{Binding PhotoWidth}" Height="{Binding PhotoHeight}"
                Clip="{Binding PhotoClip}" Background="{Binding PhotoBackground}">
            <Canvas>
              <Image Source="{Binding Image}" Stretch="Fill"
                     Canvas.Left="{Binding ImageX}" Canvas.Top="{Binding ImageY}"
                     Width="{Binding ImageWidth}" Height="{Binding ImageHeight}" RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                  <RotateTransform Angle="{Binding ImageRotation}" />
                </Image.RenderTransform>
              </Image>
            </Canvas>
            <!-- Boş yuva: altın "+" ve kısa ipucu (birim mm; Viewbox ölçekler) -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                        Visibility="{Binding ShowEmptyLabel, Converter={StaticResource BoolToVisibility}}">
              <StackPanel.RenderTransform>
                <TranslateTransform X="{Binding EmptyOffsetX}" Y="{Binding EmptyOffsetY}" />
              </StackPanel.RenderTransform>
              <ui:NexIcon Data="{StaticResource Icon.Plus}" Width="{Binding EmptyIconSize}" Height="{Binding EmptyIconSize}"
                          StrokeThickness="1.4" Foreground="#B08A45" HorizontalAlignment="Center" />
              <TextBlock Text="Fotoğraf bırakın" FontSize="{Binding EmptyFontSize}" Foreground="#9C8D74" HorizontalAlignment="Center"
                         Margin="0,1,0,0" Visibility="{Binding ShowEmptyHint, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <TextBlock Text="Dosya bulunamadı" FontSize="6" Foreground="#C62828"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding IsMissing, Converter={StaticResource BoolToVisibility}}" />
          </Grid>
          <Path Data="{Binding StrokeGeometry}" Stroke="{Binding StrokeBrush}" StrokeThickness="{Binding StrokeThickness}" />
          <Path Data="{Binding OuterGeometry}" Stroke="#C9A85E" StrokeThickness="0.45" StrokeDashArray="3 2" IsHitTestVisible="False"
                Visibility="{Binding ShowEmptyLabel, Converter={StaticResource BoolToVisibility}}" />
          <!-- Seçim ve bırakma vurgusu (yalnızca ekranda; sayfa içeriği değildir) -->
          <Path Data="{Binding OuterGeometry}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4" StrokeDashArray="3 1.5"
                IsHitTestVisible="False" Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />
          <Path Data="{Binding OuterGeometry}" Stroke="{DynamicResource AccentHoverBrush}" StrokeThickness="2" Fill="#40D4A853"
                IsHitTestVisible="False" Visibility="{Binding IsDropTarget, Converter={StaticResource BoolToVisibility}}" />
          <Path Data="{Binding OuterGeometry}" Stroke="{DynamicResource AccentHoverBrush}" StrokeThickness="1.6"
                IsHitTestVisible="False" Visibility="{Binding IsPositioning, Converter={StaticResource BoolToVisibility}}" />
        </Canvas>
      </DataTemplate>
    </ResourceDictionary>
  </Application.Resources>
</Application>
