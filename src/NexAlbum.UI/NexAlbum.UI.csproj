<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>NexAlbum</AssemblyName>
    <RootNamespace>NexAlbum.UI</RootNamespace>
    <!-- Linux/CI üzerinde derlenebilsin; çalıştırma yalnızca Windows'ta. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Marka (Karar 17): exe simgesi -->
    <ApplicationIcon>Assets\NexAlbum.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NexAlbum.Core\NexAlbum.Core.csproj" />
    <ProjectReference Include="..\NexAlbum.Rendering\NexAlbum.Rendering.csproj" />
    <ProjectReference Include="..\NexAlbum.Export\NexAlbum.Export.csproj" />
    <ProjectReference Include="..\NexAlbum.Assets\NexAlbum.Assets.csproj" />
    <ProjectReference Include="..\NexAlbum.Persistence\NexAlbum.Persistence.csproj" />
    <ProjectReference Include="..\NexAlbum.Integrations\NexAlbum.Integrations.csproj" />
    <ProjectReference Include="..\NexAlbum.Video\NexAlbum.Video.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Gömülü yazı tipi (Inter, SIL OFL 1.1) ve pencere simgesi; çalışma anında kurulum gerekmez. -->
    <Resource Include="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\AlbumFonts\*.ttf" />
    <Resource Include="Assets\NexAlbum.ico" />
    <!-- Ana pencere hazırlanırken gösterilen açılış ekranı (Karar 17 §9). -->
    <SplashScreen Include="Assets\splash.png" />
    <None Include="Assets\Fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\AlbumFonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
